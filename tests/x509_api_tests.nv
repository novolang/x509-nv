fn unique_wide() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn unknown_critical() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn unsigned_bits() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn v2_ext() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

fn wide_name() -> Bytes
    bytes.from_hex("") ?? bytes.zeros(0)

// ── reading them ────────────────────────────────────────────────────

// One extension, built out of the value its reader is handed.
//
// An extension's value is an OCTET STRING whose content is the
// structure its OID names, and a certificate is not needed to ask what
// a reader does with one: these are the values that are not the
// structure, handed to the reader that has to notice.
fn ext_value(oid: AsnOid, value: Bytes) -> AsnExtension
    AsnExtension { oid: oid, critical: true, value: value }

// The certificate a fixture holds.  A panic here is a fixture that is
// wrong rather than a rule that failed, and it names this suite so the
// failure cannot be read as another one's.
fn cert_of(der: Bytes) -> X509Cert
    let Ok(c) = x509cert.parse(der, limits()) else core.panic.panic("x509_api_tests: a certificate fixture must parse")
    c

fn certs_of(der: Bytes) -> [X509Cert]
    let Ok(cs) = x509cert.parse_all(der, limits()) else core.panic.panic("x509_api_tests: a chain fixture must parse")
    cs

fn crl_of(der: Bytes) -> X509Crl
    let Ok(l) = x509crl.parse(der, limits()) else core.panic.panic("x509_api_tests: a crl fixture must parse")
    l

fn csr_of(der: Bytes) -> X509Csr
    let Ok(r) = x509csr.parse(der, limits()) else core.panic.panic("x509_api_tests: a csr fixture must parse")
    r

// The refusal a document this package must not accept produces.
fn refusal(der: Bytes, what: Str) -> X509Error
    let Err(e) = x509cert.parse(der, limits()) else core.panic.panic("x509_api_tests: ${what} parsed, and it must be refused")
    e

fn crl_refusal(der: Bytes, what: Str) -> X509Error
    let Err(e) = x509crl.parse(der, limits()) else core.panic.panic("x509_api_tests: ${what} parsed, and it must be refused")
    e

fn csr_refusal(der: Bytes, what: Str) -> X509Error
    let Err(e) = x509csr.parse(der, limits()) else core.panic.panic("x509_api_tests: ${what} parsed, and it must be refused")
    e

// The rich certificate's extensions, and the name constraints and
// names it carries.
fn rich_exts() -> [AsnExtension]
    x509cert.extensions_of(cert_of(rich()))

// `is_ca` answers a `Result`, and a well-formed extension list is
// never the error arm of it.
fn is_ca_of(exts: [AsnExtension]) -> Bool
    let Ok(v) = x509ext.is_ca(exts, limits()) else core.panic.panic("x509_api_tests: is_ca must answer for a well-formed extension list")
    v

fn rich_constraints() -> X509NameConstraints
    let Ok(Some(c)) = x509ext.name_constraints(rich_exts(), limits()) else core.panic.panic("x509_api_tests: the rich certificate carries name constraints")
    c

fn names_list() -> [X509GeneralName]
    let Ok(Some(ns)) = x509ext.subject_alt_name(x509cert.extensions_of(cert_of(nc_names())), limits()) else core.panic.panic("x509_api_tests: the names fixture must parse")
    ns

fn anchor_of(der: Bytes) -> X509Anchor
    let Ok(a) = x509path.anchor(der, limits()) else core.panic.panic("x509_api_tests: an anchor fixture must parse")
    a

fn leaf_names() -> [X509GeneralName]
    let Ok(Some(ns)) = x509ext.subject_alt_name(x509cert.extensions_of(cert_of(leaf())), limits()) else core.panic.panic("x509_api_tests: the leaf carries subject alt names")
    ns

fn names_constraints() -> X509NameConstraints
    let Ok(Some(c)) = x509ext.name_constraints(x509cert.extensions_of(cert_of(nc_names())), limits()) else core.panic.panic("x509_api_tests: the names fixture carries name constraints")
    c

// A civil time, and an instant from an epoch day (1970-01-01 is 0).
fn clock(h: Int, m: Int, s: Int) -> CivilTime
    var t = civil.midnight()
    match civil.time_of(h, m, s, 0)
        Ok(v)  =>
            t = v
        Err(_) => ()
    t

fn at(day: Int, h: Int, m: Int, s: Int) -> CivilDateTime
    civil.datetime(civil.date_from_epoch_day(day), clock(h, m, s))

// The policy the chains below are validated under: everything
// `strict()` checks, with a signature no verifier here can check
// admitted.  The documents are signed by nobody, so "unchecked" is the
// answer this package reports rather than a failure it invents.
fn policy() -> X509PathPolicy
    x509path.allowing_unchecked_signatures(x509path.strict())

// The trust set holding one anchor.
fn trust_of(der: Bytes) -> X509TrustSet
    let Ok(a) = x509path.anchor(der, limits()) else core.panic.panic("x509_api_tests: an anchor fixture must parse")
    x509path.trust_set([a])

// The policy whose only issuer rule is the path length.
//
// A link asks three questions of the certificate above it, and
// `strict()` opens all three gates at once.  This one shuts the first
// two, so that the third is reached on its own, and declares the one
// OID it switched off — which turning name constraints off requires.
fn link_rules() -> X509PathPolicy
    X509PathPolicy { max_chain_length: x509path.X509_MAX_CHAIN_DEFAULT,
                     require_ca_flag: false, require_key_cert_sign: false,
                     enforce_path_len: true, enforce_name_constraints: false,
                     check_validity: true, require_all_signatures_checked: false,
                     known_extension_oids: [x509ext.oid_name_constraints()],
                     required_key_purpose: None }

// The first refusal walking this chain produces, under `p`.
fn fault_under(chain: Bytes, trust: X509TrustSet, p: X509PathPolicy, v: X509Verifier,
               moment: CivilDateTime) -> X509Error
    let Err(e) = x509path.validate(chain, certs_of(chain), trust, v, moment, p) else core.panic.panic("x509_api_tests: this chain validates, and it must not")
    e

// The same, under the policy and instant the path tests share.
fn fault(chain: Bytes, trust: X509TrustSet) -> X509Error
    fault_under(chain, trust, policy(), x509verify.no_verifier(), at(20100, 0, 0, 0))

fn validates(chain: Bytes, trust: X509TrustSet, p: X509PathPolicy, v: X509Verifier,
             moment: CivilDateTime) -> Bool
    match x509path.validate(chain, certs_of(chain), trust, v, moment, p)
        Ok(_)  => true
        Err(_) => false

// The refusal a conformance check produces.  A `None` here is a
// fixture that is conforming, which is a fixture that proves nothing.
fn check_conformance_of(der: Bytes) -> X509Error
    let Some(e) = x509cert.check_conformance(der, cert_of(der), limits()) else core.panic.panic("x509_api_tests: this certificate must fail a conformance check")
    e

// The refusal a list produces about a certificate it names.
fn revocation_of(der: Bytes) -> X509Error
    let Some(e) = x509crl.check_revoked(crl_rich(), crl_of(crl_rich()), der, cert_of(der), limits()) else core.panic.panic("x509_api_tests: this certificate is revoked by the rich list")
    e

// The refusal a stale list produces.
fn stale_list() -> X509Error
    let Some(e) = x509crl.check_current_at(crl_of(crl_rich()), at(20200, 0, 0, 0)) else core.panic.panic("x509_api_tests: the rich list is stale by April")
    e

// The refusal the certificate with the unrecognized critical extension
// produces.
fn unknown_critical_refusal() -> X509Error
    let Some(e) = x509ext.check_unknown_critical(x509cert.extensions_of(cert_of(unknown_critical())),
                                                  0, []) else
        core.panic.panic("x509_api_tests: 1.3.6.1.4.1.9999.1 is not implemented")
    e

fn empty_chain() -> X509Error
    var none: [X509Cert] = []
    let Err(e) = x509path.validate(bytes.zeros(0), none, trust_of(anchor()), x509verify.no_verifier(),
                                   at(20100, 0, 0, 0), policy()) else
        core.panic.panic("x509_api_tests: an empty chain is not a path")
    e

fn no_anchor() -> X509Error
    fault_under(chain(), x509path.empty_trust_set(), policy(), x509verify.no_verifier(),
                at(20100, 0, 0, 0))

fn unusable() -> X509Error
    fault_under(chain(), trust_of(anchor()),
                x509path.with_max_chain_length(policy(), 0), x509verify.no_verifier(),
                at(20100, 0, 0, 0))

// ── the verifiers ───────────────────────────────────────────────────

fn supports_ecdsa(o: AsnOid) -> Bool []
    asn1oid.equals(o, asn1oid.oid_ecdsa_with_sha256())

fn supports_ed25519(o: AsnOid) -> Bool []
    asn1oid.equals(o, asn1oid.oid_ed25519())

fn answers_good(a: AsnAlgorithmId, k: AsnSubjectPublicKeyInfo, m: Bytes,
                s: Bytes) -> X509VerifyOutcome []
    X509SignatureGood

fn answers_bad(a: AsnAlgorithmId, k: AsnSubjectPublicKeyInfo, m: Bytes,
               s: Bytes) -> X509VerifyOutcome []
    X509SignatureBad

// One that understands ECDSA and says the signature does not verify,
// and one that understands Ed25519 and says it does.
fn p256() -> X509Verifier
    x509verify.verifier("p256", supports_ecdsa, answers_good)

fn ed25519_ok() -> X509Verifier
    x509verify.verifier("ed25519", supports_ed25519, answers_good)

fn p256_bad() -> X509Verifier
    x509verify.verifier("bad-p256", supports_ecdsa, answers_bad)

fn ecdsa_alg() -> AsnAlgorithmId
    AsnAlgorithmId { algorithm: asn1oid.oid_ecdsa_with_sha256(), parameters: None }

fn alg_of(o: AsnOid) -> AsnAlgorithmId
    AsnAlgorithmId { algorithm: o, parameters: None }

// ── the tests ───────────────────────────────────────────────────────

// Every document this suite reads, parsed once.
//
// A suite whose fixtures do not parse tests the parser's refusals and
// nothing else: each assertion below would then be an assertion about
// the wrong document.  This runs first and fails with the bytes that
// were refused.
@test
fn test_every_fixture_is_a_document_this_package_reads() [io]
    var bad: [Str] = []
    let certificates = [leaf(), leaf_org(), leaf_utf8(), anchor(), pathlen0_ca(),
                        noca_mid(), no_ks_mid(), constrained_anchor(), rich(), wide_name(),
                        no_cn(), nc_bounds(), nc_names(), unique_ids(),
                        empty_subject_crit(),
                        empty_subject_plain(), empty_issuer(), unknown_critical(),
                        v2_ext(), neg_serial(), reversed(), mismatch(), params(),
                        unsigned_bits(), bad_bc(), bad_ku(), bad_eku(), ski_trailing(),
                        aki_bad(), san_trailing(), case_issuer(), crl_dp_bad()]
    for der in certificates
        match x509cert.parse(der, limits())
            Ok(_)  => ()
            Err(e) =>
                list.push(bad, "certificate ${bytes.to_hex(bytes.slice(der, 0, 12))}: ${e.message()}")
    let lists = [crl_rich(), crl_v1(), crl_delta(), crl_tagged(), crl_plain(),
                 crl_trailing_number(), crl_trailing_invalidity(), crl_long_reason(),
                 crl_empty_ext()]
    for der in lists
        match x509crl.parse(der, limits())
            Ok(_)  => ()
            Err(e) => list.push(bad, "crl ${bytes.to_hex(bytes.slice(der, 0, 12))}: ${e.message()}")
    let requests = [csr_rich(), csr_bare(), csr_empty_subject(), csr_dup(),
                    csr_bad_challenge(), csr_bad_extreq(), csr_empty_values(), csr_no_ext(),
                    csr_bad_san(), csr_key_unused()]
    for der in requests
        match x509csr.parse(der, limits())
            Ok(_)  => ()
            Err(e) => list.push(bad, "csr ${bytes.to_hex(bytes.slice(der, 0, 12))}: ${e.message()}")
    for line in bad
        println(line)
    test.assert_eq(list.len(bad), 0)

// ── the vocabulary of refusal, one arm at a time ────────────────────

// The three answers every refusal gives about itself: the token, which
// half of the enum it is in, and the place it names.  A malformed
// document names a byte, a rule failure names no byte and — for the
// arms that are about a certificate — its index.
fn pins(e: X509Error, code_text: Str, malformed: Bool, index: Int) -> Unit []
    test.assert_eq_str(x509err.code(e), code_text)
    test.assert_eq(x509err.is_malformed(e), malformed)
    test.assert_eq(x509err.is_rule_failure(e), not malformed)
    test.assert_eq(x509err.error_index(e), index)
    if malformed
        test.assert(x509err.error_offset(e) >= 0)
    else
        test.assert_eq(x509err.error_offset(e), -1)
    test.assert(str.len(e.message()) > 8)

// A reader handed a value that is not the structure its OID names
// refuses, names that OID, and does not read the part it recognized.
fn refuses<T>(r: Result<T, X509Error>, oid: Str) -> Unit []
    match r
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), oid))
            test.assert(x509err.is_malformed(e))
        Ok(_)  => test.fail("a value that is not ${oid} must be refused, not read")

@test
fn test_every_arm_of_the_refusal_vocabulary_is_reachable() [io]
    let week = at(20100, 0, 0, 0)

    test.case("the five malformed arms")
    // The offsets are the readers' own and are asserted as "somewhere
    // in the document"; the codes and the classes are the interface.
    let junk = bytes.from_hex("3005020107") ?? bytes.zeros(0)
    pins(refusal(junk, "a SEQUENCE with a length past the buffer"), "not-der", true, -1)
    let blank = bytes.from_hex("3000") ?? bytes.zeros(0)
    pins(refusal(blank, "an empty SEQUENCE"), "missing-field", true, -1)
    pins(refusal(cert_bad_version(), "a v6 certificate"), "bad-version", true, -1)
    pins(refusal(unique_constructed(), "a constructed issuerUniqueID"), "impossible-field",
         true, -1)
    match x509ext.basic_constraints(x509cert.extensions_of(cert_of(bad_bc())), limits())
        Err(e) => pins(e, "bad-extension-value", true, -1)
        Ok(_)  => test.fail("basicConstraints holding an IA5String is not the structure")

    test.case("the decode cause is carried whole, by the one arm that has one")
    match x509err.decode_cause(refusal(junk, "a truncation"))
        Some(cause) => test.assert(asn1err.decode_offset(cause) >= 0)
        None        => test.fail("not-der carries asn1-nv's own refusal")
    match x509err.decode_cause(X509MissingField(at: 1, field: "x"))
        Some(_) => test.fail("only not-der carries a decode cause")
        None    => ()

    test.case("the seventeen rule failures, each from the call that produces it")
    pins(fault_under(chain(), trust_of(anchor()), policy(), x509verify.no_verifier(),
                     at(20455, 0, 0, 0)),
                     "cert-expired", false, 0)
    pins(fault_under(chain(), trust_of(anchor()), policy(), x509verify.no_verifier(),
                     at(20088, 0, 0, 0)),
                     "cert-not-yet-valid", false, 0)
    pins(unknown_critical_refusal(), "unknown-critical-extension", false, 0)
    pins(fault(chain_reversed(), trust_of(anchor())), "issuer-not-found", false, 0)
    pins(fault(chain3(), trust_of(anchor())), "not-a-ca", false, 1)
    pins(fault(chain_no_ks(), trust_of(anchor())), "key-cert-sign-not-permitted", false, 1)
    pins(fault(chain_below_path_len(), trust_of(anchor())), "path-len-exceeded", false, 2)
    pins(fault_under(chain(), trust_of(anchor()),
                     x509path.with_max_chain_length(policy(), 1),
                     x509verify.no_verifier(), week),
                     "chain-too-long", false, -1)
    pins(fault(chain_org(), trust_of(constrained_anchor())), "name-constraint-violated",
         false, 0)
    pins(check_conformance_of(params()), "algorithm-mismatch", false, 0)
    pins(fault_under(chain(), trust_of(anchor()), policy(), p256_bad(), week),
         "signature-invalid", false, 0)
    pins(fault_under(chain(), trust_of(anchor()), x509path.strict(),
                     x509verify.no_verifier(), week),
                     "no-verifier", false, 0)
    pins(revocation_of(leaf()), "cert-revoked", false, -1)
    pins(stale_list(), "crl-not-current", false, -1)
    // The leaf of `chain()` carries no extKeyUsage, which is no
    // restriction; the rich certificate names server and client auth
    // and not code signing.
    pins(fault_under(rich() + anchor(), trust_of(anchor()),
                     x509path.requiring_key_purpose(policy(), x509ext.oid_kp_code_signing()),
                     x509verify.no_verifier(), week),
                     "key-purpose-not-permitted", false, 0)
    pins(empty_chain(), "empty-chain", false, -1)
    pins(no_anchor(), "empty-trust-set", false, -1)
    pins(unusable(), "policy-unusable", false, -1)

    test.case("is_validity_failure is the third class, and it is exactly three arms")
    let late = fault_under(chain(), trust_of(anchor()), policy(), x509verify.no_verifier(),
                           at(20455, 0, 0, 0))
    let early = fault_under(chain(), trust_of(anchor()), policy(), x509verify.no_verifier(),
                            at(20088, 0, 0, 0))
    test.assert(x509err.is_validity_failure(late))
    test.assert(x509err.is_validity_failure(early))
    test.assert(x509err.is_validity_failure(stale_list()))
    test.assert(not x509err.is_validity_failure(X509SignatureInvalid(index: 0)))
    test.assert(not x509err.is_validity_failure(X509MissingField(at: 0, field: "x")))

// ── the extensions ──────────────────────────────────────────────────

@test
fn test_an_extension_is_found_by_the_oid_it_carries() [io]
    let exts = rich_exts()

    test.case("the set of OIDs this package reads is published, and it did not shrink")
    test.assert_eq(list.len(x509ext.known_oids()), 13)

    test.case("find answers the extension, and None for an OID that is not there")
    match x509ext.find(exts, x509ext.oid_subject_key_identifier())
        Some(e) => test.assert_eq_str(bytes.to_hex(x509ext.extension_value(e)),
                                      "040401020304")
        None    => test.fail("the rich certificate carries a subject key identifier")
    match x509ext.find(exts, asn1oid.oid_basic_constraints())
        Some(e) => test.assert_eq_str(bytes.to_hex(x509ext.extension_value(e)),
                                      "3003010100")
        None    => test.fail("the rich certificate carries basicConstraints")
    match x509ext.find(exts, asn1oid.oid([1, 3, 6, 1, 4, 1, 9999, 7]))
        Some(_) => test.fail("that OID is on nothing")
        None    => ()

    test.case("critical is a property of the extension and not of the OID")
    test.assert(x509ext.is_critical(exts, x509ext.oid_name_constraints()))
    test.assert(not x509ext.is_critical(exts, asn1oid.oid_basic_constraints()))
    test.assert(not x509ext.is_critical(exts, asn1oid.oid([1, 3, 6, 1, 4, 1, 9999, 7])))

    test.case("a critical extension this package reads is not an unknown one")
    test.assert_eq(list.len(x509ext.unknown_critical(exts, [])), 0)
    let strange = x509cert.extensions_of(cert_of(unknown_critical()))
    let found = x509ext.unknown_critical(strange, [])
    test.assert_eq(list.len(found), 1)
    match x509ext.find(strange, asn1oid.oid([1, 3, 6, 1, 4, 1, 9999, 1]))
        Some(e) => test.assert_eq_str(bytes.to_hex(x509ext.extension_value(e)), "0500")
        None    => test.fail("the fixture carries 1.3.6.1.4.1.9999.1")

    test.case("a caller's own OID makes a critical extension known")
    test.assert_eq(list.len(x509ext.unknown_critical(strange,
                                                     [asn1oid.oid([1, 3, 6, 1, 4, 1, 9999, 1])])),
                   0)
    match x509ext.check_unknown_critical(exts, 3, [])
        Some(_) => test.fail("nothing in the rich certificate is unrecognized")
        None    => ()
    match x509ext.check_unknown_critical(strange, 2, [])
        Some(e) => test.assert_eq_str(x509err.code(e), "unknown-critical-extension")
        None    => test.fail("1.3.6.1.4.1.9999.1 is not implemented here")

@test
fn test_basic_constraints_and_key_usage_are_read_bit_by_bit() [io]
    test.case("the CA flag and the path length, absent meaning unlimited")
    match x509ext.basic_constraints(rich_exts(), limits())
        Ok(Some(bc)) =>
            test.assert(not bc.is_ca)
            test.assert_eq(bc.path_len, -1)
        Ok(None)     => test.fail("the rich certificate carries basicConstraints")
        Err(e)       => test.fail(e.message())
    match x509ext.basic_constraints(x509cert.extensions_of(cert_of(anchor())), limits())
        Ok(Some(bc)) =>
            test.assert(bc.is_ca)
            test.assert_eq(bc.path_len, -1)
        Ok(None)     => test.fail("the anchor carries basicConstraints")
        Err(e)       => test.fail(e.message())
    match x509ext.basic_constraints(x509cert.extensions_of(cert_of(pathlen0_ca())), limits())
        Ok(Some(bc)) => test.assert_eq(bc.path_len, 0)
        Ok(None)     => test.fail("the constrained CA carries basicConstraints")
        Err(e)       => test.fail(e.message())

    test.case("is_ca folds the absence of the extension into false")
    test.assert(is_ca_of(x509cert.extensions_of(cert_of(anchor()))))
    test.assert(not is_ca_of(rich_exts()))
    test.assert(not is_ca_of([]))

    test.case("a basicConstraints that is not the structure is refused")
    match x509ext.basic_constraints(x509cert.extensions_of(cert_of(bad_bc())), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.19"))
        Ok(_)  => test.fail("an IA5String is not a BasicConstraints")

    test.case("the nine key-usage bits, numbered from the most significant")
    match x509ext.key_usage(rich_exts(), limits())
        Ok(Some(k)) =>
            test.assert(k.digital_signature)
            test.assert(not k.non_repudiation)
            test.assert(k.key_encipherment)
            test.assert(not k.data_encipherment)
            test.assert(not k.key_agreement)
            test.assert(k.key_cert_sign)
            test.assert(not k.crl_sign)
            test.assert(not k.encipher_only)
            test.assert(not k.decipher_only)
            test.assert(x509ext.key_usage_bit(k, x509ext.X509_KU_KEY_CERT_SIGN))
            test.assert(not x509ext.key_usage_bit(k, 6))
            // Bit n and field n are one bit seen two ways, one by one,
            // so a caller holding a number read out of a configuration
            // file gets the same answer as one holding the name.
            test.assert_eq(x509ext.key_usage_bit(k, 0), k.digital_signature)
            test.assert_eq(x509ext.key_usage_bit(k, 1), k.non_repudiation)
            test.assert_eq(x509ext.key_usage_bit(k, 2), k.key_encipherment)
            test.assert_eq(x509ext.key_usage_bit(k, 3), k.data_encipherment)
            test.assert_eq(x509ext.key_usage_bit(k, 4), k.key_agreement)
            test.assert_eq(x509ext.key_usage_bit(k, 5), k.key_cert_sign)
            test.assert_eq(x509ext.key_usage_bit(k, 6), k.crl_sign)
            test.assert_eq(x509ext.key_usage_bit(k, 7), k.encipher_only)
            test.assert_eq(x509ext.key_usage_bit(k, 8), k.decipher_only)
        Ok(None)    => test.fail("the rich certificate carries keyUsage")
        Err(e)      => test.fail(e.message())
    match x509ext.key_usage(x509cert.extensions_of(cert_of(no_ks_mid())), limits())
        Ok(Some(k)) =>
            test.assert(k.digital_signature)
            test.assert(not k.key_cert_sign)
            test.assert(not x509ext.key_usage_bit(k, 9))
            test.assert(not x509ext.key_usage_bit(k, -1))
        Ok(None)    => test.fail("the middle certificate carries keyUsage")
        Err(e)      => test.fail(e.message())

    test.case("absence means unrestricted, which is the opposite of basicConstraints")
    match x509ext.key_usage([], limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("no extension is not a key usage")
        Err(e)      => test.fail(e.message())
    match x509ext.key_usage(x509cert.extensions_of(cert_of(bad_ku())), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.15"))
        Ok(_)  => test.fail("an IA5String is not a KeyUsage")

    test.case("every bit has the name the ASN.1 module gives it, and 9 has none")
    test.assert_eq_str(x509ext.key_usage_name(0), "digitalSignature")
    test.assert_eq_str(x509ext.key_usage_name(1), "nonRepudiation")
    test.assert_eq_str(x509ext.key_usage_name(2), "keyEncipherment")
    test.assert_eq_str(x509ext.key_usage_name(3), "dataEncipherment")
    test.assert_eq_str(x509ext.key_usage_name(4), "keyAgreement")
    test.assert_eq_str(x509ext.key_usage_name(5), "keyCertSign")
    test.assert_eq_str(x509ext.key_usage_name(6), "cRLSign")
    test.assert_eq_str(x509ext.key_usage_name(7), "encipherOnly")
    test.assert_eq_str(x509ext.key_usage_name(8), "decipherOnly")
    test.assert_eq_str(x509ext.key_usage_name(9), "")
    test.assert_eq_str(x509ext.key_usage_name(-1), "")

@test
fn test_extended_key_usage_is_a_list_of_oids() [io]
    test.case("the purposes the rich certificate names, in order")
    match x509ext.extended_key_usage(rich_exts(), limits())
        Ok(Some(purposes)) =>
            test.assert_eq(list.len(purposes), 2)
            test.assert_eq_str(asn1oid.oid_text(purposes[0]), "1.3.6.1.5.5.7.3.1")
            test.assert_eq_str(asn1oid.oid_text(purposes[1]), "1.3.6.1.5.5.7.3.2")
        Ok(None)           => test.fail("the rich certificate carries extKeyUsage")
        Err(e)             => test.fail(e.message())

    test.case("absence is no restriction, which is not the same as an empty list")
    match x509ext.extended_key_usage(x509cert.extensions_of(cert_of(anchor())), limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the anchor carries no extKeyUsage")
        Err(e)      => test.fail(e.message())

    test.case("has_key_purpose honours anyExtendedKeyUsage, which is the rule by hand misses")
    let kp = [x509ext.oid_kp_server_auth(), x509ext.oid_kp_client_auth()]
    test.assert(x509ext.has_key_purpose(kp, x509ext.oid_kp_server_auth()))
    test.assert(x509ext.has_key_purpose(kp, x509ext.oid_kp_client_auth()))
    test.assert(not x509ext.has_key_purpose(kp, x509ext.oid_kp_code_signing()))
    test.assert(x509ext.has_key_purpose([x509ext.oid_any_extended_key_usage()],
                                        x509ext.oid_kp_time_stamping()))
    test.assert(not x509ext.has_key_purpose([], x509ext.oid_kp_ocsp_signing()))

    test.case("an extKeyUsage holding a non-OID is refused by name")
    match x509ext.extended_key_usage(x509cert.extensions_of(cert_of(bad_eku())), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.37"))
        Ok(_)  => test.fail("an IA5String is not an ExtKeyUsageSyntax")

@test
fn test_a_general_name_is_read_as_its_own_form() [io]
    let names = names_list()
    test.assert_eq(list.len(names), 27)

    test.case("each of the eight arms, rendered the way a certificate dump renders it")
    test.assert_eq_str(x509ext.general_name_text(names[0]), "DNS:example.com")
    test.assert_eq_str(x509ext.general_name_text(names[1]), "DNS:EXAMPLE.COM")
    test.assert_eq_str(x509ext.general_name_text(names[10]), "IP:192.0.2.1")
    test.assert_eq_str(x509ext.general_name_text(names[6]), "email:ops@example.com")
    test.assert_eq_str(x509ext.general_name_text(names[14]), "URI:https://example.com/x")
    test.assert_eq_str(x509ext.general_name_text(names[20]), "DirName:CN=Acme")
    test.assert_eq_str(x509ext.general_name_text(names[17]), "RID:1.3.6.1.4.1.9999")
    test.assert_eq_str(x509ext.general_name_text(names[19]),
                       "otherName:1.3.6.1.4.1.9999.2")
    test.assert_eq_str(x509ext.general_name_text(names[26]), "unsupported:3")

    test.case("an address renders at the length it was written, and a mask is not an address")
    test.assert_eq_str(x509ext.general_name_text(
                           X509IpAddress(octets: bytes.from_hex("20010db8000000000000000000000001") ?? bytes.zeros(0))),
                       "IP:2001:0db8:0000:0000:0000:0000:0000:0001")
    // Sixteen octets is eight groups, uncompressed: this is a dump of
    // the bytes and not a canonical text form.
    test.assert_eq_str(x509ext.general_name_text(
                           X509IpAddress(octets: bytes.from_hex("00000000000000000000000000000000") ?? bytes.zeros(0))),
                       "IP:0000:0000:0000:0000:0000:0000:0000:0000")
    // An address-and-mask out of a name constraint is neither length,
    // so it is hex — the rule that keeps a constraint's eight octets
    // from being read as two addresses.
    test.assert_eq_str(x509ext.general_name_text(
                           X509IpAddress(octets: bytes.from_hex("c0000201ff") ?? bytes.zeros(0))),
                       "IP:c0000201ff")

    test.case("the arms carry their own payloads, not their text")
    match names[10]
        X509IpAddress(octets) => test.assert_eq_str(bytes.to_hex(octets), "c0000201")
        _                     => test.fail("index 10 is an address")
    match names[20]
        X509DirectoryName(n) => test.assert_eq(x509name.rdn_count(n), 1)
        _                    => test.fail("index 20 is a directory name")
    match names[19]
        X509OtherName(o, v) =>
            test.assert_eq_str(asn1oid.oid_text(o), "1.3.6.1.4.1.9999.2")
            test.assert_eq_str(bytes.to_hex(v), "0c0178")
        _                   => test.fail("index 19 is an otherName")
    match names[26]
        X509UnsupportedName(tag, v) =>
            test.assert_eq(tag, 3)
            test.assert_eq_str(bytes.to_hex(v), "83020102")
        _                           => test.fail("index 26 is an unsupported name")

    test.case("the two lists a program matches a host or an address with")
    test.assert_eq(list.len(x509ext.dns_names(names)), 6)
    test.assert_eq_str(x509ext.dns_names(names)[1], "EXAMPLE.COM")
    test.assert_eq_str(x509ext.dns_names(names)[0], "example.com")
    let addresses = x509ext.ip_addresses(names)
    test.assert_eq(list.len(addresses), 4)
    test.assert_eq_str(bytes.to_hex(addresses[0]), "c0000201")
    test.assert_eq(list.len(x509ext.dns_names([])), 0)
    test.assert_eq(list.len(x509ext.ip_addresses([])), 0)

    test.case("the rich certificate's alternative names, and its issuer's")
    let rich = x509ext.subject_alt_name(rich_exts(), limits())
    match rich
        Ok(Some(ns)) =>
            test.assert_eq(list.len(ns), 9)
            test.assert_eq_str(x509ext.general_name_text(ns[7]), "otherName:1.3.6.1.4.1.9999.2")
        Ok(None)     => test.fail("the rich certificate carries subjectAltName")
        Err(e)       => test.fail(e.message())
    match x509ext.issuer_alt_name(rich_exts(), limits())
        Ok(Some(ns)) =>
            test.assert_eq(list.len(ns), 1)
            test.assert_eq_str(x509ext.general_name_text(ns[0]), "DNS:ca.example.com")
        Ok(None)     => test.fail("the rich certificate carries issuerAltName")
        Err(e)       => test.fail(e.message())
    match x509ext.subject_alt_name(x509cert.extensions_of(cert_of(anchor())), limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the anchor carries no subjectAltName")
        Err(e)      => test.fail(e.message())

@test
fn test_a_length_inside_an_extension_is_checked_against_the_bytes_that_are_there() [io]
    // RFC 5280 puts every extension's value inside an OCTET STRING, and
    // the structure inside it is the OID's business.  A value with a
    // byte after the structure is refused rather than half-read: this
    // is the innermost of the three places a length can lie, and the
    // one a reader that trusted its writer would miss.
    test.case("a subject key identifier with a byte after the digest")
    match x509ext.subject_key_identifier(x509cert.extensions_of(cert_of(ski_trailing())),
                                         limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.14"))
        Ok(_)  => test.fail("an OCTET STRING with a byte after it is not the value")

    test.case("a subject alternative name with a byte after the SEQUENCE")
    match x509ext.subject_alt_name(x509cert.extensions_of(cert_of(san_trailing())), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.17"))
        Ok(_)  => test.fail("a GeneralNames with a byte after it is not the value")

    test.case("an authority key identifier that is not the structure at all")
    match x509ext.authority_key_identifier(x509cert.extensions_of(cert_of(aki_bad())),
                                           limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.35"))
        Ok(_)  => test.fail("an INTEGER is not an AuthorityKeyIdentifier")

@test
fn test_the_key_identifiers_are_carried_or_absent() [io]
    test.case("the subject key identifier is the OCTET STRING inside the value")
    match x509ext.subject_key_identifier(rich_exts(), limits())
        Ok(Some(id)) => test.assert_eq_str(bytes.to_hex(id), "01020304")
        Ok(None)     => test.fail("the rich certificate carries a subject key identifier")
        Err(e)       => test.fail(e.message())
    match x509ext.subject_key_identifier([], limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("no extension is not a key identifier")
        Err(e)      => test.fail(e.message())

    test.case("all three fields of the authority key identifier")
    match x509ext.authority_key_identifier(rich_exts(), limits())
        Ok(Some(aki)) =>
            match aki.key_identifier
                Some(k) => test.assert_eq_str(bytes.to_hex(k), "aabbccdd")
                None    => test.fail("the fixture names a key identifier")
            test.assert_eq(list.len(aki.authority_cert_issuer), 1)
            test.assert_eq_str(x509ext.general_name_text(aki.authority_cert_issuer[0]),
                               "DNS:example.com")
            match aki.authority_cert_serial
                Some(s) => test.assert_eq_str(bytes.to_hex(s), "2a")
                None    => test.fail("the fixture names a serial number")
            test.assert_eq(aki.authority_cert_serial == None, false)
        Ok(None)      => test.fail("the rich certificate carries an authority key identifier")
        Err(e)        => test.fail(e.message())

    test.case("a certificate with neither identifier answers None for both")
    let exts = x509cert.extensions_of(cert_of(anchor()))
    match x509ext.subject_key_identifier(exts, limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the anchor carries no subject key identifier")
        Err(e)      => test.fail(e.message())
    match x509ext.authority_key_identifier(exts, limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the anchor carries no authority key identifier")
        Err(e)      => test.fail(e.message())

@test
fn test_name_constraints_are_matched_by_form_and_by_subtree() [io]
    let nc = names_constraints()
    let names = names_list()

    test.case("the two lists are kept apart and in order")
    test.assert_eq(list.len(nc.permitted), 6)
    test.assert_eq(list.len(nc.excluded), 5)

    test.case("a DNS name inside the permitted subtree, and one outside it")
    test.assert(x509ext.constraints_permit(nc, X509DnsName(name: "www.example.com")))
    test.assert(not x509ext.constraints_permit(nc, X509DnsName(name: "www.example.org")))
    test.case("the boundary is a label boundary, not a suffix")
    test.assert(not x509ext.constraints_permit(nc, X509DnsName(name: "notexample.com")))
    test.case("and the case does not matter, because these are DNS names")
    test.assert(x509ext.constraints_permit(nc, X509DnsName(name: "WWW.EXAMPLE.COM")))

    test.case("a subtree of only a domain covers any mailbox below it")
    let mail = X509NameConstraints { permitted: [X509GeneralSubtree {
        base: X509EmailAddress(address: ".allowed.example"), minimum: -1, maximum: -1 }],
        excluded: [] }
    test.assert(x509ext.constraints_permit(mail, X509EmailAddress(address: "a@x.allowed.example")))
    test.assert(not x509ext.constraints_permit(mail, X509EmailAddress(address: "a@notallowed.example")))

    test.case("excluded is checked before permitted, so a name in both is refused")
    test.assert(not x509ext.constraints_permit(nc, X509DnsName(name: "evil.example.com")))
    test.assert(not x509ext.constraints_permit(nc, X509EmailAddress(address: "boss@example.com")))
    test.assert(not x509ext.constraints_permit(nc,
        X509IpAddress(octets: bytes.from_hex("c0000281") ?? bytes.zeros(0))))

    test.case("a form with permitted subtrees but no matching one is refused")
    test.assert(not x509ext.constraints_permit(nc, X509Uri(uri: "https://other.example/x")))
    test.case("a form no subtree mentions is not constrained by this extension")
    test.assert(x509ext.constraints_permit(nc, X509OtherName(oid: asn1oid.oid([1, 2, 3]),
                                                             value: bytes.zeros(0))))

    test.case("an extension with neither list permits everything")
    let none_left = X509NameConstraints { permitted: [], excluded: [] }
    test.assert(x509ext.constraints_permit(none_left, X509DnsName(name: "anything.at.all")))

    test.case("the minimum and maximum of a subtree are read, and -1 means absent")
    let bounded = X509NameConstraints { permitted: [X509GeneralSubtree {
        base: X509DnsName(name: "example.com"), minimum: 1, maximum: 3 }],
        excluded: [] }
    test.assert_eq(bounded.permitted[0].minimum, 1)
    test.assert_eq(bounded.permitted[0].maximum, 3)
    // `minimum [0] BaseDistance DEFAULT 0`, so absent is 0; `maximum`
    // has no default and absent is the -1 this package uses for it.
    test.assert_eq(nc.permitted[0].minimum, 0)
    test.assert_eq(nc.permitted[0].maximum, -1)

    test.case("the fixture's constraints, read off the wire")
    test.assert_eq(list.len(nc.permitted), 6)
    test.assert_eq(list.len(nc.excluded), 5)
    match nc.permitted[0].base
        X509DnsName(name) => test.assert_eq_str(name, "example.com")
        _                 => test.fail("the first permitted subtree is a DNS name")

    test.case("the rich certificate's own constraints, and a certificate with none")
    match x509ext.name_constraints(rich_exts(), limits())
        Ok(Some(parsed)) =>
            test.assert_eq(list.len(parsed.permitted), 2)
            test.assert_eq(list.len(parsed.excluded), 4)
            test.assert_eq(parsed.permitted[0].minimum, 0)
            test.assert_eq(parsed.permitted[0].maximum, -1)
        Ok(None)         => test.fail("the rich certificate carries nameConstraints")
        Err(e)           => test.fail(e.message())
    match x509ext.name_constraints(x509cert.extensions_of(cert_of(anchor())), limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the anchor carries no nameConstraints")
        Err(e)      => test.fail(e.message())

    test.case("an email constraint that is a host, and one that is a whole mailbox")
    let as_host = X509NameConstraints { permitted: [X509GeneralSubtree {
        base: X509EmailAddress(address: "example.com"), minimum: 0, maximum: -1 }],
        excluded: [] }
    test.assert(x509ext.constraints_permit(as_host,
                                           X509EmailAddress(address: "user@example.com")))
    test.assert(x509ext.constraints_permit(as_host,
                                           X509EmailAddress(address: "user@sub.example.com")))
    // An address with no `@` at all is its own host: the part after the
    // last one is the whole string when there is none.
    test.assert(x509ext.constraints_permit(as_host, X509EmailAddress(address: "EXAMPLE.COM")))
    test.assert(not x509ext.constraints_permit(as_host,
                                               X509EmailAddress(address: "user@example.org")))
    let as_mailbox = X509NameConstraints { permitted: [X509GeneralSubtree {
        base: X509EmailAddress(address: "ops@example.com"), minimum: 0, maximum: -1 }],
        excluded: [] }
    test.assert(x509ext.constraints_permit(as_mailbox,
                                           X509EmailAddress(address: "OPS@Example.Com")))
    test.assert(not x509ext.constraints_permit(as_mailbox,
                                               X509EmailAddress(address: "user@example.com")))

    test.case("a URI constraint is read off the URI, and a URI with no authority matches nothing")
    let as_uri = X509NameConstraints { permitted: [X509GeneralSubtree {
        base: X509Uri(uri: "example.com"), minimum: 0, maximum: -1 }],
        excluded: [] }
    test.assert(x509ext.constraints_permit(as_uri, X509Uri(uri: "https://example.com/index")))
    test.assert(x509ext.constraints_permit(as_uri, X509Uri(uri: "EXAMPLE.COM:8443/x")))
    test.assert(not x509ext.constraints_permit(as_uri, X509Uri(uri: "https://example.org/x")))
    // A URI whose authority is empty names no host, so no constraint
    // over hosts can be said to cover it.
    test.assert(not x509ext.constraints_permit(as_uri, X509Uri(uri: "http://")))

    test.case("a subtree rooted at a form this package does not match is not a match")
    let odd = X509GeneralSubtree { base: X509OtherName(oid: asn1oid.oid([1, 2, 3]),
                                                      value: bytes.zeros(0)),
                                   minimum: 0, maximum: -1 }
    test.assert(not x509ext.subtree_contains(odd, X509OtherName(oid: asn1oid.oid([1, 2, 3]),
                                                                value: bytes.zeros(0))))
    test.assert(not x509ext.subtree_contains(odd, X509DnsName(name: "example.com")))

    test.case("a relative distinguished name is compared as a set, and a set of another size is not it")
    let dirs = X509NameConstraints { permitted: [X509GeneralSubtree {
        base: X509DirectoryName(name: x509cert.subject_of(cert_of(leaf()))), minimum: 0,
        maximum: -1 }],
        excluded: [] }
    test.assert(x509ext.constraints_permit(dirs,
        X509DirectoryName(name: x509cert.subject_of(cert_of(leaf())))))
    // The six attributes a relative name can hold, out of a
    // distribution point: one RDN with TWO attributes is not one RDN
    // with one, whatever the two of them say.
    let rel_exts = [ext_value(x509ext.oid_crl_distribution_points(), dp_relative_two())]
    let Ok(Some(points)) = x509ext.crl_distribution_points(rel_exts, limits()) else core.panic.panic("x509_api_tests: a relative name fixture must read")
    test.assert_eq(list.len(points[0].relative_name), 2)
    let leaf_name = x509cert.subject_of(cert_of(leaf()))
    let two = X509DirectoryName(name: AsnName {
        rdns: [AsnRdn { attributes: points[0].relative_name }], span: leaf_name.span })
    test.assert(not x509ext.constraints_permit(dirs, two))

    test.case("the whole list the certificate asserts, judged name by name")
    // The names are in the order the fixture writes them: permitted
    // forms first, then excluded ones, then the forms no subtree
    // mentions.  The expected column is what RFC 5280 section 4.2.1.10
    // says about each.  Sixteen of the twenty-seven are refused: the
    // six that are refused only because the exclusion beats the
    // permission — among them the two directory names that differ
    // from the excluded subtree in case alone, which RFC 5280 section
    // 7.1's `caseIgnoreMatch` still refuses — and the ten that a
    // permitted subtree of their own form does not cover.
    let expected = [true, true, true, false, false, false, false, true, false, false,
                    true, false, false, false, true, true, false, false, false, true,
                    true, false, false, true, false, false, true]
    var i = 0
    var refused = 0
    for n in names
        let here = x509ext.constraints_permit(nc, n)
        if here != expected[i]
            if here
                test.fail("name ${i} is permitted, and RFC 5280 refuses it")
            else
                test.fail("name ${i} is refused, and RFC 5280 permits it")
        if not here
            refused = refused + 1
        i = i + 1
    test.assert_eq(i, 27)
    // One for each `false` in the column above.
    test.assert_eq(refused, 16)

@test
fn test_distribution_points_and_policies_are_read_from_the_value() [io]
    test.case("every kind of distribution point in one extension, in order")
    match x509ext.crl_distribution_points(rich_exts(), limits())
        Ok(Some(points)) =>
            test.assert_eq(list.len(points), 4)
            test.assert_eq(list.len(points[0].full_name), 1)
            test.assert_eq_str(x509ext.general_name_text(points[0].full_name[0]),
                               "URI:http://crl.example.com/a.crl")
            test.assert_eq(points[0].reasons, -1)
            test.assert_eq(list.len(points[0].relative_name), 0)
            test.assert_eq(list.len(points[0].crl_issuer), 0)
            test.assert_eq(list.len(points[1].full_name), 0)
            test.assert_eq(list.len(points[1].relative_name), 1)
            test.assert_eq_str(asn1oid.oid_text(points[1].relative_name[0].oid), "2.5.4.3")
            test.assert_eq(points[1].reasons, -1)
            test.assert_eq(points[2].reasons, 1)
            test.assert_eq(list.len(points[3].crl_issuer), 1)
            test.assert_eq_str(x509ext.general_name_text(points[3].crl_issuer[0]),
                               "DNS:crl.example.com")
            let uris = x509ext.distribution_point_uris(points[0])
            test.assert_eq(list.len(uris), 1)
            test.assert_eq_str(uris[0], "http://crl.example.com/a.crl")
            test.assert_eq(list.len(x509ext.distribution_point_uris(points[1])), 0)
        Ok(None)         => test.fail("the rich certificate carries cRLDistributionPoints")
        Err(e)           => test.fail(e.message())

    test.case("a point that is only a name still reads, and names no URI")
    let dp = X509DistributionPoint { full_name: [X509DnsName(name: "crl.example.com")],
                                     relative_name: [], crl_issuer: [], reasons: 0 }
    test.assert_eq(list.len(x509ext.distribution_point_uris(dp)), 0)
    test.assert_eq_str(x509ext.general_name_text(dp.full_name[0]), "DNS:crl.example.com")

    test.case("an element of a distribution point that is not one of the three is refused")
    match x509ext.crl_distribution_points(x509cert.extensions_of(cert_of(crl_dp_bad())), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.31"))
        Ok(_)  => test.fail("a [5] element is not a DistributionPoint field")

    test.case("a policy is an OID and its qualifiers keep their own DER")
    match x509ext.certificate_policies(rich_exts(), limits())
        Ok(Some(policies)) =>
            test.assert_eq(list.len(policies), 2)
            test.assert_eq_str(asn1oid.oid_text(policies[0].oid), "2.23.140.1.2.1")
            test.assert_eq(list.len(policies[0].qualifiers), 1)
            test.assert_eq_str(asn1oid.oid_text(policies[0].qualifiers[0].oid),
                               "1.3.6.1.5.5.7.2.1")
            test.assert_eq_str(bytes.to_hex(policies[0].qualifiers[0].value),
                               "161768747470733a2f2f6578616d706c652e636f6d2f637073")
            test.assert_eq_str(asn1oid.oid_text(policies[1].oid), "2.5.29.32.0")
            test.assert_eq(list.len(policies[1].qualifiers), 0)
        Ok(None)           => test.fail("the rich certificate carries certificatePolicies")
        Err(e)             => test.fail(e.message())

    test.case("a certificate with no policies answers None")
    match x509ext.certificate_policies(x509cert.extensions_of(cert_of(anchor())), limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the anchor carries no certificatePolicies")
        Err(e)      => test.fail(e.message())

    test.case("a policy with no qualifier is still a policy")
    let bare = X509PolicyInfo { oid: asn1oid.oid([2, 23, 140, 1, 2, 2]), qualifiers: [] }
    test.assert_eq_str(asn1oid.oid_text(bare.oid), "2.23.140.1.2.2")
    test.assert_eq(list.len(bare.qualifiers), 0)

    test.case("a policy is asserted by OID, and anyPolicy is honoured")
    let policies = [bare]
    test.assert(x509ext.asserts_policy(policies, asn1oid.oid([2, 23, 140, 1, 2, 2])))
    test.assert(not x509ext.asserts_policy(policies, asn1oid.oid([2, 23, 140, 1, 2, 1])))
    test.assert(x509ext.asserts_policy([X509PolicyInfo { oid: x509ext.oid_any_policy(),
                                                         qualifiers: [] }],
                                       asn1oid.oid([1, 2, 3])))
    test.assert(not x509ext.asserts_policy([], asn1oid.oid([1, 2, 3])))

    test.case("the OIDs the module publishes, told apart from one another")
    test.assert_eq_str(asn1oid.oid_text(asn1oid.oid_basic_constraints()), "2.5.29.19")
    test.assert_eq_str(asn1oid.oid_text(asn1oid.oid_key_usage()), "2.5.29.15")
    test.assert_eq_str(asn1oid.oid_text(asn1oid.oid_ext_key_usage()), "2.5.29.37")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_subject_key_identifier()), "2.5.29.14")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_authority_key_identifier()), "2.5.29.35")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_issuer_alt_name()), "2.5.29.18")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_name_constraints()), "2.5.29.30")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_crl_distribution_points()), "2.5.29.31")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_certificate_policies()), "2.5.29.32")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_any_policy()), "2.5.29.32.0")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_policy_mappings()), "2.5.29.33")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_policy_constraints()), "2.5.29.36")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_inhibit_any_policy()), "2.5.29.54")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_any_extended_key_usage()), "2.5.29.37.0")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_kp_server_auth()), "1.3.6.1.5.5.7.3.1")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_kp_client_auth()), "1.3.6.1.5.5.7.3.2")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_kp_code_signing()), "1.3.6.1.5.5.7.3.3")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_kp_email_protection()), "1.3.6.1.5.5.7.3.4")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_kp_time_stamping()), "1.3.6.1.5.5.7.3.8")
    test.assert_eq_str(asn1oid.oid_text(x509ext.oid_kp_ocsp_signing()), "1.3.6.1.5.5.7.3.9")

// ── the revocation list ─────────────────────────────────────────────

@test
fn test_a_list_reads_its_entries_its_numbers_and_its_reasons() [io]
    let l = crl_of(crl_rich())

    test.case("the fields a v2 list carries")
    test.assert_eq(l.version, x509crl.X509_CRL_VERSION_2)
    test.assert_eq(x509crl.entry_count(l), 3)
    test.assert_eq(list.len(x509crl.entries_of(l)), 3)
    test.assert_eq(list.len(x509crl.extensions_of(l)), 1)
    test.assert_eq(x509name.rdn_count(x509crl.issuer_of(l)), 1)
    test.assert_eq(list.len(x509ext.unknown_critical(x509crl.extensions_of(l), [])), 0)

    test.case("the entries keep the order the list wrote them in")
    let entries = x509crl.entries_of(l)
    test.assert_eq_str(bytes.to_hex(entries[0].serial), "0a")
    test.assert_eq_str(bytes.to_hex(entries[1].serial), "0b")
    test.assert_eq_str(bytes.to_hex(entries[2].serial), "0c")
    test.assert_eq(list.len(entries[0].extensions), 2)
    test.assert_eq(list.len(entries[1].extensions), 0)
    test.assert_eq(list.len(entries[2].extensions), 1)

    test.case("a lookup is by serial, and it is pure")
    test.assert(x509crl.is_revoked(l, bytes.from_hex("0a") ?? bytes.zeros(0)))
    test.assert(not x509crl.is_revoked(l, bytes.from_hex("0d") ?? bytes.zeros(0)))
    match x509crl.entry_for(l, bytes.from_hex("0b") ?? bytes.zeros(0))
        Some(e) => test.assert_eq_str(bytes.to_hex(e.serial), "0b")
        None    => test.fail("serial 11 is in the list")
    match x509crl.entry_for(l, bytes.from_hex("ff") ?? bytes.zeros(0))
        Some(_) => test.fail("serial 255 is not in the list")
        None    => ()

    test.case("the reason of the first entry, and the absence in the second")
    match x509crl.revocation_reason(entries[0], limits())
        Ok(Some(r)) =>
            test.assert_eq(x509crl.reason_number(r), 1)
            test.assert_eq_str(x509crl.reason_name(r), "keyCompromise")
        Ok(None)    => test.fail("entry 10 carries a cRLReasons extension")
        Err(e)      => test.fail(e.message())
    match x509crl.revocation_reason(entries[1], limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("entry 11 carries no reason, which is not the same as unspecified")
        Err(e)      => test.fail(e.message())

    test.case("the invalidity date, which is the date that matters for old signatures")
    match x509crl.invalidity_date(entries[0], limits())
        Ok(Some(d)) => test.assert_eq(civil.compare_datetime(d, at(20089, 0, 0, 0)), 0)
        Ok(None)    => test.fail("entry 10 carries an invalidityDate")
        Err(e)      => test.fail(e.message())
    match x509crl.invalidity_date(entries[1], limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("entry 11 carries no invalidity date")
        Err(e)      => test.fail(e.message())

    test.case("the certificate issuer of an indirect entry")
    match x509crl.certificate_issuer(entries[2], limits())
        Ok(Some(names)) =>
            test.assert_eq(list.len(names), 1)
            test.assert_eq_str(x509ext.general_name_text(names[0]), "DNS:crl.example.com")
        Ok(None)        => test.fail("entry 12 carries a certificateIssuer")
        Err(e)          => test.fail(e.message())
    match x509crl.certificate_issuer(entries[0], limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("entry 10 carries no certificateIssuer")
        Err(e)      => test.fail(e.message())

    test.case("the list's own number, and the delta indicator it does not carry")
    match x509crl.crl_number(l, limits())
        Ok(Some(n)) => test.assert_eq_str(bytes.to_hex(n), "05")
        Ok(None)    => test.fail("the rich list carries a cRLNumber")
        Err(e)      => test.fail(e.message())
    match x509crl.delta_crl_indicator(l, limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the rich list is not a delta")
        Err(e)      => test.fail(e.message())
    let delta = crl_of(crl_delta())
    match x509crl.delta_crl_indicator(delta, limits())
        Ok(Some(n)) => test.assert_eq_str(bytes.to_hex(n), "03")
        Ok(None)    => test.fail("the delta list carries a deltaCRLIndicator")
        Err(e)      => test.fail(e.message())

    test.case("a v1 list has no entries, no extensions and no nextUpdate")
    let old = crl_of(crl_v1())
    test.assert_eq(old.version, x509crl.X509_CRL_VERSION_1)
    test.assert_eq(x509crl.entry_count(old), 0)
    test.assert_eq(list.len(x509crl.extensions_of(old)), 0)
    match old.next_update
        None    => ()
        Some(_) => test.fail("the v1 list names no nextUpdate")
    match x509crl.crl_number(old, limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the v1 list carries no cRLNumber")
        Err(e)      => test.fail(e.message())

    test.case("an entry extension written with the tag a writer might guess is ignored, not read")
    // RFC 5280's module writes `crlEntryExtensions` UNTAGGED.  A list
    // that wrapped it in `[0]` anyway parses, and the element is an
    // unrecognized extra: the reason is NOT read.  Reading it is what
    // this package used to do, and it dropped every conforming entry's
    // extensions instead.
    let tagged = crl_of(crl_tagged())
    test.assert_eq(x509crl.entry_count(tagged), 1)
    test.assert_eq(list.len(x509crl.entries_of(tagged)[0].extensions), 0)
    match x509crl.revocation_reason(x509crl.entries_of(tagged)[0], limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the tagged element is not read")
        Err(e)      => test.fail(e.message())

    test.case("a reason that is not one ENUMERATED of one byte")
    // Three ways the value can fail to be the number it must be, and
    // each is a refusal rather than a guessed zero — zero means
    // `unspecified` and is a reason a writer may really have meant.
    match x509crl.revocation_reason(x509crl.entries_of(crl_of(crl_reason_int()))[0], limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.21"))
        Ok(_)  => test.fail("an INTEGER is not an ENUMERATED")
    match x509crl.revocation_reason(x509crl.entries_of(crl_of(crl_reason_wide()))[0], limits())
        Err(e) => test.assert_eq_str(x509err.code(e), "bad-extension-value")
        Ok(_)  => test.fail("an ENUMERATED two bytes wide is not one byte")
    let two = x509crl.entries_of(crl_of(crl_reason_two()))[0]
    match x509crl.revocation_reason(two, limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.21"))
        Ok(_)  => test.fail("two ENUMERATEDs are not one value")
    // And the same value reached the other way: a certificate the list
    // names, whose reason cannot be read.
    match x509crl.check_revoked(crl_reason_two(), crl_of(crl_reason_two()), leaf(),
                                cert_of(leaf()), limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.21"))
        None    => test.fail("the list names the leaf and cannot say why")

    test.case("a date and a number that are not one value each")
    match x509crl.invalidity_date(
            x509crl.entries_of(crl_of(crl_trailing_invalidity()))[0], limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.24"))
        Ok(_)  => test.fail("a GeneralizedTime with a byte after it is not one value")
    match x509crl.crl_number(crl_of(crl_trailing_number()), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.20"))
        Ok(_)  => test.fail("a cRLNumber with a byte after it is not one value")
    match x509crl.crl_number(crl_of(crl_number_two()), limits())
        Err(e) => test.assert_eq_str(x509err.code(e), "bad-extension-value")
        Ok(_)  => test.fail("two INTEGERs are not one cRLNumber")
    match x509crl.delta_crl_indicator(crl_of(crl_delta_two()), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.27"))
        Ok(_)  => test.fail("two INTEGERs are not one indicator")
    match x509crl.delta_crl_indicator(crl_of(crl_delta_ia5()), limits())
        Err(e) => test.assert_eq_str(x509err.code(e), "bad-extension-value")
        Ok(_)  => test.fail("an IA5String is not a delta indicator")

    test.case("a list extension written critical, and the question a reader has to ask about it")
    // RFC 5280 section 4.2 applies to a list as much as to a
    // certificate: a critical extension a reader does not implement
    // makes the document unusable.  A cRLNumber is one this package
    // reads, and the flag is kept rather than refused — but
    // `known_oids` is the list of CERTIFICATE extensions, so the OIDs
    // a CRL carries are the caller's to declare, and until it does the
    // extension is unrecognized and critical, which is what the
    // reader that acts on this is told.
    let critical = crl_of(crl_crit_ext())
    test.assert_eq(list.len(x509crl.extensions_of(critical)), 1)
    test.assert(x509ext.is_critical(x509crl.extensions_of(critical),
                                     x509crl.oid_crl_number()))
    test.assert_eq(list.len(x509ext.unknown_critical(x509crl.extensions_of(critical), [])), 1)
    test.assert_eq(list.len(x509ext.unknown_critical(x509crl.extensions_of(critical),
                                                     [x509crl.oid_crl_number()])),
                                                     0)
    match x509ext.check_unknown_critical(x509crl.extensions_of(critical), 0, [])
        Some(e) => test.assert_eq_str(x509err.code(e), "unknown-critical-extension")
        None    => test.fail("a critical extension no reader here knows is unrecognized")

@test
fn test_the_currency_window_is_closed_at_both_ends_and_the_clock_is_an_argument() [io]
    // The instant is the caller's.  Nothing in this package reads a
    // clock, so one list and four moments give four answers, and the
    // same call gives the same answer forever.
    let l = crl_of(crl_rich())
    test.assert_eq(civil.compare_datetime(l.this_update, at(20089, 0, 0, 0)), 0)
    match l.next_update
        Some(u) => test.assert_eq(civil.compare_datetime(u, at(20120, 0, 0, 0)), 0)
        None    => test.fail("the rich list names a nextUpdate")

    test.case("before thisUpdate, which is not yet a statement about anything")
    test.assert(not x509crl.is_current_at(l, at(20088, 23, 59, 59)))
    test.case("exactly at thisUpdate: IN, because the window is closed at the near end")
    test.assert(x509crl.is_current_at(l, at(20089, 0, 0, 0)))
    test.case("exactly at nextUpdate: IN, because it is closed at the far end too")
    test.assert(x509crl.is_current_at(l, at(20120, 0, 0, 0)))
    test.case("one second past nextUpdate: OUT")
    test.assert(not x509crl.is_current_at(l, at(20120, 0, 0, 1)))
    test.assert(not x509crl.is_current_at(l, at(20121, 0, 0, 0)))

    test.case("the refusal names both moments so a report can say how stale")
    match x509crl.check_current_at(l, at(20121, 0, 0, 0))
        Some(e) =>
            pins(e, "crl-not-current", false, -1)
            test.assert(str.contains(e.message(), "2025-02-01"))
        None    => test.fail("the list is stale in February 2025 at the latest")
    match x509crl.check_current_at(l, at(20120, 0, 0, 0))
        Some(_) => test.fail("the far end is in the window")
        None    => ()
    pins(stale_list(), "crl-not-current", false, -1)

    test.case("a list with no nextUpdate is current from thisUpdate onwards, and says so")
    let old = crl_of(crl_v1())
    match old.next_update
        None    => ()
        Some(_) => test.fail("the v1 list names no nextUpdate")
    test.assert(not x509crl.is_current_at(old, at(20088, 23, 59, 59)))
    test.assert(x509crl.is_current_at(old, at(20089, 0, 0, 0)))
    test.assert(x509crl.is_current_at(old, at(30000, 0, 0, 0)))
    match x509crl.check_current_at(old, at(20088, 0, 0, 0))
        Some(e) => test.assert(str.contains(e.message(), "no nextUpdate"))
        None    => test.fail("the v1 list is not yet current in December 2024")

@test
fn test_a_list_refuses_what_it_cannot_read_rather_than_guessing() [io]
    let bad = crl_of(crl_bad())
    test.case("a cRLNumber that is not an integer")
    match x509crl.crl_number(bad, limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.20"))
        Ok(_)  => test.fail("an IA5String is not a CRLNumber")
    let entries = x509crl.entries_of(bad)
    test.case("a reason number the enumeration does not use")
    match x509crl.revocation_reason(entries[0], limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.21"))
        Ok(_)  => test.fail("7 is the hole in the numbering")
    test.case("an invalidityDate that is not a time")
    match x509crl.invalidity_date(entries[1], limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.24"))
        Ok(_)  => test.fail("an INTEGER is not a Time")
    test.case("a reason that is a whole number above the enumeration")
    match x509crl.revocation_reason(x509crl.entries_of(crl_of(crl_long_reason()))[0], limits())
        Err(e) => test.assert(str.contains(e.message(), "2.5.29.21"))
        Ok(_)  => test.fail("200 is not a CRLReason")

    test.case("a list with a field missing is refused by name")
    pins(crl_refusal(crl_short(), "a SEQUENCE with no signature algorithm"), "missing-field",
         true, -1)
    test.case("a signature BIT STRING with unused bits is impossible, not merely odd")
    match x509crl.signature_bytes(crl_of(crl_unsigned_bits()))
        Err(e) => pins(e, "impossible-field", true, -1)
        Ok(_)  => test.fail("three unused bits in a signature is not a signature")
    test.case("a version above v2 is refused where it is written")
    pins(crl_refusal(crl_bad_version(), "a v3 list"), "bad-version", true, -1)
    test.case("a certificate's bytes are not a list, and the reader names the version it finds")
    // A certificate's tbsCertificate opens with `[0] version` holding
    // 2, which the CRL reader reads as its own version field — and 2
    // is v3, one CRL version above the v2 RFC 5280 uses.
    pins(crl_refusal(leaf(), "a certificate handed to the CRL reader"), "bad-version", true, -1)

@test
fn test_the_reason_enumeration_round_trips_and_has_exactly_one_hole() [io]
    let numbers = [0, 1, 2, 3, 4, 5, 6, 8, 9, 10]
    for n in numbers
        match x509crl.reason_named(n)
            Some(r) =>
                test.assert_eq(x509crl.reason_number(r), n)
                test.assert(str.len(x509crl.reason_name(r)) > 4)
            None    => test.fail("${n} is a number RFC 5280 gives a reason")
    test.case("7 is the hole, and 11 and everything above it is too")
    match x509crl.reason_named(7)
        Some(_) => test.fail("7 is unused in the CRLReason enumeration")
        None    => ()
    match x509crl.reason_named(11)
        Some(_) => test.fail("11 is above the enumeration")
        None    => ()
    match x509crl.reason_named(-1)
        Some(_) => test.fail("a negative reason is not one")
        None    => ()

    test.case("each name is the ASN.1 module's own, so a report needs no table")
    test.assert_eq_str(x509crl.reason_name(X509ReasonUnspecified), "unspecified")
    test.assert_eq_str(x509crl.reason_name(X509ReasonKeyCompromise), "keyCompromise")
    test.assert_eq_str(x509crl.reason_name(X509ReasonCaCompromise), "cACompromise")
    test.assert_eq_str(x509crl.reason_name(X509ReasonAffiliationChanged), "affiliationChanged")
    test.assert_eq_str(x509crl.reason_name(X509ReasonSuperseded), "superseded")
    test.assert_eq_str(x509crl.reason_name(X509ReasonCessationOfOperation), "cessationOfOperation")
    test.assert_eq_str(x509crl.reason_name(X509ReasonCertificateHold), "certificateHold")
    test.assert_eq_str(x509crl.reason_name(X509ReasonRemoveFromCrl), "removeFromCRL")
    test.assert_eq_str(x509crl.reason_name(X509ReasonPrivilegeWithdrawn), "privilegeWithdrawn")
    test.assert_eq_str(x509crl.reason_name(X509ReasonAaCompromise), "aACompromise")

    test.case("the reason a revocation reports is the name, not the number")
    match x509crl.check_revoked(crl_rich(), crl_of(crl_rich()), leaf(), cert_of(leaf()), limits())
        Some(e) =>
            pins(e, "cert-revoked", false, -1)
            test.assert(str.contains(e.message(), "0a"))
            test.assert(str.contains(e.message(), "keyCompromise"))
        None    => test.fail("the rich list revokes serial 10")
    match x509crl.check_revoked(crl_rich(), crl_of(crl_rich()), leaf_org(), cert_of(leaf_org()),
                                limits())
        Some(e) =>
            pins(e, "cert-revoked", false, -1)
            test.assert(str.contains(e.message(), "unspecified"))
        None    => test.fail("the rich list revokes serial 11, which carries no reason")

    test.case("a serial number is unique only under one issuer, so the name is compared too")
    test.assert(x509crl.is_revoked_by(crl_rich(), crl_of(crl_rich()), leaf(), cert_of(leaf())))
    test.assert(not x509crl.is_revoked_by(crl_rich(), crl_of(crl_rich()), leaf_utf8(),
                                          cert_of(leaf_utf8())))
    test.case("the same two answers from the refusal-producing call")
    match x509crl.check_revoked(crl_rich(), crl_of(crl_rich()), leaf_utf8(),
                                cert_of(leaf_utf8()), limits())
        Some(_) => test.fail("a name that ENCODES differently is a different issuer")
        None    => ()
    test.case("and a certificate the list has never heard of")
    match x509crl.check_revoked(crl_rich(), crl_of(crl_rich()), pathlen0_ca(),
                                cert_of(pathlen0_ca()), limits())
        Some(_) => test.fail("serial 2 is not in the rich list")
        None    => ()

@test
fn test_a_certification_request_reads_its_attributes() [io]
    let r = csr_of(csr_rich())

    test.case("version, subject and the attributes in the order they were written")
    test.assert_eq(r.version, x509csr.X509_CSR_VERSION_1)
    test.assert_eq(x509name.rdn_count(x509csr.subject_of(r)), 1)
    test.assert_eq(list.len(x509csr.attributes_of(r)), 2)
    test.assert_eq_str(asn1oid.oid_text(x509csr.attributes_of(r)[0].oid),
                       "1.2.840.113549.1.9.7")
    test.assert_eq_str(asn1oid.oid_text(x509csr.attributes_of(r)[1].oid),
                       "1.2.840.113549.1.9.14")

    test.case("the attribute lookup, and its absence")
    match x509csr.attribute_by_oid(r, x509csr.oid_extension_request())
        Some(a) => test.assert_eq(list.len(a.values), 1)
        None    => test.fail("the request carries an extensionRequest")
    match x509csr.attribute_by_oid(r, asn1oid.oid([1, 2, 3]))
        Some(_) => test.fail("no such attribute is in the request")
        None    => ()
    test.assert_eq_str(asn1oid.oid_text(x509csr.oid_extension_request()),
                       "1.2.840.113549.1.9.14")
    test.assert_eq_str(asn1oid.oid_text(x509csr.oid_challenge_password()),
                       "1.2.840.113549.1.9.7")

    test.case("the challenge password, which travels in the clear")
    match x509csr.challenge_password(r, limits())
        Ok(Some(p)) => test.assert_eq_str(p, "hunter2")
        Ok(None)    => test.fail("the request carries a challengePassword")
        Err(e)      => test.fail(e.message())

    test.case("the extensions that were ASKED FOR, as the same type a certificate's are")
    match x509csr.requested_extensions(r, limits())
        Ok(exts) =>
            test.assert_eq(list.len(exts), 1)
            test.assert_eq_str(asn1oid.oid_text(exts[0].oid), "2.5.29.17")
        Err(e)   => test.fail(e.message())
    match x509csr.requested_dns_names(r, limits())
        Ok(names) =>
            test.assert_eq(list.len(names), 1)
            test.assert_eq_str(names[0], "example.com")
        Err(e)    => test.fail(e.message())

    test.case("a request asking for nothing")
    let bare = csr_of(csr_bare())
    test.assert_eq(list.len(x509csr.attributes_of(bare)), 0)
    match x509csr.requested_extensions(bare, limits())
        Ok(exts) => test.assert_eq(list.len(exts), 0)
        Err(e)   => test.fail(e.message())
    match x509csr.requested_dns_names(bare, limits())
        Ok(names) => test.assert_eq(list.len(names), 0)
        Err(e)    => test.fail(e.message())
    match x509csr.challenge_password(bare, limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("the bare request carries no challengePassword")
        Err(e)      => test.fail(e.message())

    test.case("an attribute present with no value at all")
    match x509csr.challenge_password(csr_of(csr_empty_values()), limits())
        Ok(None)    => ()
        Ok(Some(_)) => test.fail("an attribute with no values has no password")
        Err(e)      => test.fail(e.message())

    test.case("a request with no extensionRequest still answers an empty list")
    match x509csr.requested_extensions(csr_of(csr_no_ext()), limits())
        Ok(exts) => test.assert_eq(list.len(exts), 0)
        Err(e)   => test.fail(e.message())

    test.case("the span and bytes of the info, which is what the signature covers")
    let span = x509csr.info_span(r)
    test.assert_eq(span.off, 3)
    test.assert(span.off + span.len < bytes.len(csr_rich()))
    test.assert_eq(bytes.len(x509csr.info_bytes(csr_rich(), r)), span.len)
    test.assert_eq_str(bytes.to_hex(x509csr.info_bytes(csr_rich(), r)),
                       bytes.to_hex(bytes.slice(csr_rich(), span.off, span.off + span.len)))
    match x509csr.signature_bytes(r)
        Ok(s)  => test.assert_eq(bytes.len(s), 1)
        Err(e) => test.fail(e.message())
    match x509csr.signature_bytes(csr_of(csr_unsigned_bits()))
        Err(e) => pins(e, "impossible-field", true, -1)
        Ok(_)  => test.fail("three unused bits in a signature is not a signature")

@test
fn test_a_request_refuses_a_value_that_is_not_what_its_oid_names() [io]
    test.case("a challengePassword that is not a string")
    match x509csr.challenge_password(csr_of(csr_bad_challenge()), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "1.2.840.113549.1.9.7"))
        Ok(_)  => test.fail("an INTEGER is not a DirectoryString")

    test.case("an extensionRequest whose value is not an Extensions SEQUENCE")
    match x509csr.requested_extensions(csr_of(csr_bad_extreq()), limits())
        Err(e) => test.assert(x509err.is_malformed(e))
        Ok(_)  => test.fail("an INTEGER is not a SEQUENCE OF Extension")

    test.case("an extensionRequest with a byte after the SEQUENCE — the length pin, innermost")
    let stray_extreq = csr_refusal(csr_trailing_extreq(),
                                   "an attributes SET with a byte the length cannot cover")
    test.assert(x509err.is_malformed(stray_extreq))
    test.assert(x509err.error_offset(stray_extreq) >= 0)
    test.assert(str.contains(stray_extreq.message(), "runs past"))

    test.case("and a challengePassword with a byte after the string")
    let stray_challenge = csr_refusal(csr_trailing_challenge(),
                                      "a challengePassword SET with a stray byte")
    test.assert(x509err.is_malformed(stray_challenge))
    test.assert(x509err.error_offset(stray_challenge) >= 0)

    test.case("a subjectAltName whose value is not a GeneralNames, read one level deeper")
    let bad = csr_of(csr_bad_san())
    match x509csr.requested_extensions(bad, limits())
        Ok(exts) => test.assert_eq(list.len(exts), 1)
        Err(e)   => test.fail(e.message())
    match x509csr.requested_dns_names(bad, limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.17"))
        Ok(_)  => test.fail("an IA5String is not a GeneralNames")

    test.case("an attribute type written twice is impossible, not merely odd")
    match x509csr.check_conformance(csr_dup(), csr_of(csr_dup()), limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "impossible-field")
            test.assert(str.contains(e.message(), "twice"))
        None    => test.fail("two challengePassword attributes leave a reader guessing")

    test.case("a SET OF written in descending order is refused, with the rule named")
    let unsorted = csr_refusal(csr_unsorted(), "attributes in descending order")
    test.assert_eq_str(x509err.code(unsorted), "impossible-field")
    test.assert(str.contains(unsorted.message(), "SET OF"))

    test.case("a version this package does not read")
    pins(csr_refusal(csr_bad_version(), "a v1 request"), "bad-version", true, -1)

    test.case("an extensionRequest whose attribute holds no value at all")
    let bare = csr_of(csr_empty_extreq())
    match x509csr.requested_extensions(bare, limits())
        Ok(exts) => test.assert_eq(list.len(exts), 0)
        Err(e)   => test.fail(e.message())

    test.case("an extension written critical, which is a flag and not a refusal")
    match x509csr.requested_extensions(csr_of(csr_crit_ext()), limits())
        Ok(exts) =>
            test.assert_eq(list.len(exts), 1)
            test.assert(x509ext.is_critical(exts, asn1oid.oid_subject_alt_name()))
            test.assert_eq_str(asn1oid.oid_text(exts[0].oid), "2.5.29.17")
        Err(e)   => test.fail(e.message())

    test.case("and an extensionRequest whose value is not a SEQUENCE OF Extension")
    match x509csr.check_conformance(csr_bad_extreq(), csr_of(csr_bad_extreq()), limits())
        Some(e) =>
            // The refusal comes from asn1-nv, which reads the INTEGER at
            // the position the SEQUENCE belongs and says so by tag.
            test.assert(x509err.is_malformed(e))
            test.assert(str.contains(e.message(), "expected tag 16"))
        None    => test.fail("an INTEGER is not a SEQUENCE OF Extension")

    test.case("an attribute value that is more than one DER value")
    // parse never hands over a value with a second DER value after it:
    // asn1-nv refuses the attribute first.  A caller that built the
    // struct by hand can, though, and the reader has to refuse rather
    // than read the first value and leave the rest of its length
    // unchecked.
    let rich2 = csr_of(csr_rich())
    let two_values = [X509CsrAttribute {
        oid: x509csr.oid_extension_request(),
        values: [bytes.from_hex("020101020102") ?? bytes.zeros(0)] }]
    let doubled = X509Csr { version: rich2.version, subject: rich2.subject,
                            public_key: rich2.public_key, attributes: two_values,
                            signature_algorithm: rich2.signature_algorithm,
                            signature: rich2.signature, info: rich2.info }
    match x509csr.requested_extensions(doubled, limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "1.2.840.113549.1.9.14"))
        Ok(_)  => test.fail("two DER values are not one Extensions SEQUENCE")
    // The same guard over the other attribute this module reads.
    let two_secrets = [X509CsrAttribute {
        oid: x509csr.oid_challenge_password(),
        values: [bytes.from_hex("0c01610c0162") ?? bytes.zeros(0)] }]
    let doubled_secret = X509Csr { version: rich2.version, subject: rich2.subject,
                                   public_key: rich2.public_key, attributes: two_secrets,
                                   signature_algorithm: rich2.signature_algorithm,
                                   signature: rich2.signature, info: rich2.info }
    match x509csr.challenge_password(doubled_secret, limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "1.2.840.113549.1.9.7"))
        Ok(_)  => test.fail("two UTF8Strings are not one password")

    test.case("an attributes field that is not `[0]`, and the three spans a caller supplies")
    pins(csr_refusal(csr_bad_attrs(), "an INTEGER where the attributes belong"),
         "missing-field", true, -1)
    // `check_conformance` reads a struct a caller built as well as one
    // this package parsed, so it has to check the spans it was given
    // rather than trust them.
    let rich = csr_of(csr_rich())
    let outside = X509Csr { version: rich.version, subject: rich.subject,
                            public_key: rich.public_key, attributes: rich.attributes,
                            signature_algorithm: rich.signature_algorithm,
                            signature: rich.signature,
                            info: AsnSpan { off: 0, len: bytes.len(csr_rich()) + 1 } }
    match x509csr.check_conformance(csr_rich(), outside, limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "missing-field")
            test.assert(str.contains(e.message(), "certificationRequestInfo"))
        None    => test.fail("a span past the buffer is not a field")
    let v5 = X509Csr { version: 5, subject: rich.subject, public_key: rich.public_key,
                       attributes: rich.attributes,
                       signature_algorithm: rich.signature_algorithm,
                       signature: rich.signature, info: rich.info }
    match x509csr.check_conformance(csr_rich(), v5, limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "bad-version")
            test.assert_eq(x509err.error_index(e), -1)
        None    => test.fail("a version this package does not read is refused")
    let one_arc = X509Csr {
        version: rich.version, subject: rich.subject,
        public_key: AsnSubjectPublicKeyInfo {
            algorithm: AsnAlgorithmId { algorithm: asn1oid.oid([1]), parameters: None },
            public_key: rich.public_key.public_key },
        attributes: rich.attributes, signature_algorithm: rich.signature_algorithm,
        signature: rich.signature, info: rich.info }
    match x509csr.check_conformance(csr_rich(), one_arc, limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "impossible-field")
            test.assert(str.contains(e.message(), "two arcs"))
        None    => test.fail("an algorithm identifier has at least two arcs")

    test.case("a request that passes every check a reader can make on its own")
    match x509csr.check_conformance(csr_rich(), csr_of(csr_rich()), limits())
        Some(e) => test.fail("the rich request is conforming: ${e.message()}")
        None    => ()
    test.case("and the two a reader refuses: a public key with unused bits")
    match x509csr.check_conformance(csr_key_unused(), csr_of(csr_key_unused()), limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "impossible-field")
            test.assert(str.contains(e.message(), "unused bits"))
        None    => test.fail("a PKIX public key has no unused bits")
    test.case("and an empty subject")
    match x509csr.check_conformance(csr_empty_subject(), csr_of(csr_empty_subject()), limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "impossible-field")
            test.assert(str.contains(e.message(), "certified under a name"))
        None    => test.fail("a request asks to be certified under a name")

// ── one certificate, and the bytes it is made of ────────────────────

@test
fn test_a_certificate_answers_what_it_holds() [io]
    let c = cert_of(leaf())

    test.case("the fields a certificate viewer prints")
    test.assert_eq(c.version, x509cert.X509_VERSION_3)
    test.assert_eq(x509cert.version_of(c), 3)
    test.assert_eq_str(x509cert.serial_hex(c), "0a")
    test.assert_eq(x509name.rdn_count(x509cert.issuer_of(c)), 1)
    test.assert_eq(x509name.rdn_count(x509cert.subject_of(c)), 1)
    match x509name.common_name(x509cert.subject_of(c))
        Some(n) => test.assert_eq_str(n, "Example Leaf")
        None    => test.fail("the subject has a common name")
    match x509name.common_name(x509cert.issuer_of(c))
        Some(n) => test.assert_eq_str(n, "Example CA")
        None    => test.fail("the issuer has a common name")
    test.assert_eq_str(asn1oid.oid_text(x509cert.public_key_algorithm(c)),
                       "1.2.840.10045.2.1")

    test.case("the algorithms agree, and `params` is the fixture where they do not")
    test.assert(x509cert.algorithms_agree(c))
    test.assert(not x509cert.algorithms_agree(cert_of(params())))

    test.case("self-issued is about the two names, not about the signature")
    test.assert(x509cert.is_self_issued(anchor(), cert_of(anchor())))
    test.assert(not x509cert.is_self_issued(leaf(), c))

    test.case("extensions are found by OID, and a certificate with none answers an empty list")
    test.assert(x509cert.has_extension(c, asn1oid.oid_subject_alt_name()))
    test.assert(not x509cert.has_extension(c, x509ext.oid_name_constraints()))
    test.assert_eq(list.len(x509cert.extensions_of(c)), 1)
    test.assert_eq(list.len(x509cert.extensions_of(cert_of(wide_name()))), 0)
    test.assert(not x509cert.has_extension(cert_of(wide_name()),
                                           asn1oid.oid_subject_alt_name()))

    test.case("the three spans and the bytes they name")
    test.assert_eq(bytes.len(x509cert.der_bytes(leaf(), c)), bytes.len(leaf()))
    test.assert_eq_str(bytes.to_hex(x509cert.der_bytes(leaf(), c)),
                       bytes.to_hex(leaf()))
    let tbs = x509cert.tbs_span(c)
    test.assert_eq(tbs.off, 3)
    test.assert_eq(c.der.off, 0)
    test.assert_eq(c.der.len, bytes.len(leaf()))
    test.assert_eq(bytes.len(x509cert.tbs_bytes(leaf(), c)), tbs.len)
    test.assert_eq_str(bytes.to_hex(x509cert.tbs_bytes(leaf(), c)),
                       bytes.to_hex(bytes.slice(leaf(), tbs.off, tbs.off + tbs.len)))
    match x509cert.signature_bytes(c)
        Ok(s)  => test.assert_eq(bytes.len(s), 1)
        Err(e) => test.fail(e.message())
    match x509cert.signature_bytes(cert_of(unsigned_bits()))
        Err(e) => pins(e, "impossible-field", true, -1)
        Ok(_)  => test.fail("three unused bits in a signature is not a signature")

    test.case("the public key is handed over whole, for a verification package to read")
    let k = x509cert.public_key_of(c)
    test.assert_eq_str(asn1oid.oid_text(k.algorithm.algorithm), "1.2.840.10045.2.1")
    test.assert_eq(k.public_key.unused_bits, 0)
    // The fixtures carry a one-byte key: this package hands the BIT
    // STRING's bytes over and never looks inside them.
    test.assert_eq(bytes.len(k.public_key.data), 1)

    test.case("a certificate with no subject, under a critical subjectAltName")
    match x509cert.check_conformance(empty_subject_crit(),
                                     cert_of(empty_subject_crit()), limits())
        Some(e) => test.fail("an empty subject with a critical SAN is conforming: ${e.message()}")
        None    => ()

@test
fn test_conformance_refuses_the_certificate_no_ca_should_have_issued() [io]
    test.case("a certificate this package is happy with")
    match x509cert.check_conformance(leaf(), cert_of(leaf()), limits())
        Some(e) => test.fail("the leaf is conforming: ${e.message()}")
        None    => ()

    test.case("extensions on a certificate below v3")
    let v2 = check_conformance_of(v2_ext())
    test.assert_eq_str(x509err.code(v2), "impossible-field")
    test.assert(str.contains(v2.message(), "version 3"))

    test.case("an empty issuer, which is never conforming")
    let issuer = check_conformance_of(empty_issuer())
    test.assert_eq_str(x509err.code(issuer), "impossible-field")
    test.assert(str.contains(issuer.message(), "issuer"))

    test.case("an empty subject WITHOUT a critical subjectAltName")
    let subject = check_conformance_of(empty_subject_plain())
    test.assert_eq_str(x509err.code(subject), "impossible-field")
    test.assert(str.contains(subject.message(), "critical subjectAltName"))

    test.case("a negative serial, which the leading zero of a positive one avoids")
    let neg = check_conformance_of(neg_serial())
    test.assert_eq_str(x509err.code(neg), "impossible-field")
    test.assert(str.contains(neg.message(), "negative"))

    test.case("a validity period that ends before it begins")
    let reversed = check_conformance_of(reversed())
    test.assert_eq_str(x509err.code(reversed), "impossible-field")
    test.assert(str.contains(reversed.message(), "notAfter"))

    test.case("two algorithm identifiers that disagree: a mismatch, not a malformed document")
    let mismatch = check_conformance_of(mismatch())
    test.assert_eq_str(x509err.code(mismatch), "algorithm-mismatch")
    test.assert(not x509err.is_malformed(mismatch))

    test.case("and the one where the parameters differ: absent is not the same as NULL")
    let params = check_conformance_of(params())
    test.assert_eq_str(x509err.code(params), "algorithm-mismatch")

    test.case("the same parameters on both identifiers agree, NULL or absent alike")
    match x509cert.check_conformance(params_same(), cert_of(params_same()), limits())
        Some(e) => test.fail("two NULL parameters agree: ${e.message()}")
        None    => ()
    // The other direction: the inner identifier names NULL and the
    // outer names nothing, and those are two different algorithms.
    let outer_absent = check_conformance_of(params_outer_absent())
    test.assert_eq_str(x509err.code(outer_absent), "algorithm-mismatch")

    test.case("a serial number an INTEGER of no length at all")
    // asn1-nv refuses an INTEGER with no content octet before this
    // package sees one, so the only way to reach the rule is a struct
    // a caller built — which is exactly what `check_conformance`
    // takes, and why the rule is here rather than in the parser.
    let leaf_cert = cert_of(leaf())
    let no_serial = X509Cert { version: leaf_cert.version, serial: bytes.zeros(0),
                               signature_algorithm: leaf_cert.signature_algorithm,
                               issuer: leaf_cert.issuer, subject: leaf_cert.subject,
                               not_before: leaf_cert.not_before, not_after: leaf_cert.not_after,
                               public_key: leaf_cert.public_key,
                               extensions: leaf_cert.extensions,
                               issuer_unique_id: leaf_cert.issuer_unique_id,
                               subject_unique_id: leaf_cert.subject_unique_id,
                               outer_algorithm: leaf_cert.outer_algorithm,
                               signature: leaf_cert.signature, tbs: leaf_cert.tbs,
                               der: leaf_cert.der }
    match x509cert.check_conformance(leaf(), no_serial, limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "impossible-field")
            test.assert(str.contains(e.message(), "zero length"))
        None    => test.fail("a serial number of zero length is impossible")

    test.case("a span a caller wrote past the end of the bytes it points into")
    // The other two spans `check_conformance` is handed rather than
    // computing: it reads `src` and a struct, and a caller that built
    // the struct can point either span anywhere.  A check that read
    // through one of them without checking it would read past the
    // buffer.
    let short_der = X509Cert { version: leaf_cert.version, serial: leaf_cert.serial,
                               signature_algorithm: leaf_cert.signature_algorithm,
                               issuer: leaf_cert.issuer, subject: leaf_cert.subject,
                               not_before: leaf_cert.not_before, not_after: leaf_cert.not_after,
                               public_key: leaf_cert.public_key,
                               extensions: leaf_cert.extensions,
                               issuer_unique_id: leaf_cert.issuer_unique_id,
                               subject_unique_id: leaf_cert.subject_unique_id,
                               outer_algorithm: leaf_cert.outer_algorithm,
                               signature: leaf_cert.signature, tbs: leaf_cert.tbs,
                               der: AsnSpan { off: 0, len: bytes.len(leaf()) + 1 } }
    match x509cert.check_conformance(leaf(), short_der, limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "missing-field")
            test.assert(str.contains(e.message(), "tbsCertificate"))
        None    => test.fail("a span past the buffer is not a field")
    let short_tbs = X509Cert { version: leaf_cert.version, serial: leaf_cert.serial,
                               signature_algorithm: leaf_cert.signature_algorithm,
                               issuer: leaf_cert.issuer, subject: leaf_cert.subject,
                               not_before: leaf_cert.not_before, not_after: leaf_cert.not_after,
                               public_key: leaf_cert.public_key,
                               extensions: leaf_cert.extensions,
                               issuer_unique_id: leaf_cert.issuer_unique_id,
                               subject_unique_id: leaf_cert.subject_unique_id,
                               outer_algorithm: leaf_cert.outer_algorithm,
                               signature: leaf_cert.signature,
                               tbs: AsnSpan { off: bytes.len(leaf()), len: 1 },
                               der: leaf_cert.der }
    match x509cert.check_conformance(leaf(), short_tbs, limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "missing-field")
            test.assert(str.contains(e.message(), "tbsCertificate"))
        None    => test.fail("a span past the buffer is not a field")

    test.case("a tbsCertificate that stops before the six fields it must carry")
    let short = refusal(tbs_short(), "a tbsCertificate with one field")
    test.assert_eq_str(x509err.code(short), "missing-field")
    test.assert(str.contains(short.message(), "signature"))

// ── a length that lies ──────────────────────────────────────────────

@test
fn test_a_truncated_document_is_refused_at_every_nesting_depth() [io]
    // A length is a claim about bytes the reader does not yet have.
    // The outer SEQUENCE, the tbsCertificate inside it, a name inside
    // that, and an extension value inside that: four depths, and a
    // reader that trusted any of them without checking it against the
    // bytes present would read past the end of the buffer.  Each cut
    // below lands inside a different one of the four.
    let full = rich()
    let n = bytes.len(full)
    let cuts = [1, 2, 5, 16, 60, n / 2, n - 120, n - 40, n - 5, n - 1]
    var refused = 0
    for cut in cuts
        if cut > 0 and cut < n
            let piece = bytes.slice(full, 0, cut)
            match x509cert.parse(piece, limits())
                Ok(_)  => test.fail("a certificate cut to ${cut} of ${n} bytes parsed")
                Err(e) =>
                    test.assert(x509err.is_malformed(e))
                    let off = x509err.error_offset(e)
                    test.assert(off >= 0)
                    test.assert(off <= cut)
                    refused = refused + 1
    test.assert_eq(refused, list.len(cuts))

    test.case("the same for a chain of two certificates, cut between them")
    let both = chain()
    let half = bytes.len(leaf())
    match x509cert.parse_all(bytes.slice(both, 0, half + 8), limits())
        Ok(_)  => test.fail("half of the second certificate parsed as a chain")
        Err(e) => test.assert(x509err.is_malformed(e))
    match x509cert.parse_all(bytes.slice(both, 0, half), limits())
        Ok(cs) =>
            test.assert_eq(list.len(cs), 1)
            test.assert_eq_str(x509cert.serial_hex(cs[0]), "0a")
        Err(e) => test.fail("exactly one certificate is a chain of one: ${e.message()}")

    test.case("a list cut inside its entry list, and inside its signature")
    let l = crl_rich()
    let m = bytes.len(l)
    for cut in [1, 20, m / 2, m - 30, m - 1]
        if cut > 0 and cut < m
            let piece = bytes.slice(l, 0, cut)
            match x509crl.parse(piece, limits())
                Ok(_)  => test.fail("a list cut to ${cut} of ${m} bytes parsed")
                Err(e) =>
                    test.assert(x509err.is_malformed(e))
                    test.assert(x509err.error_offset(e) >= 0)

    test.case("a request cut inside its attributes, and inside its signature")
    let r = csr_rich()
    let k = bytes.len(r)
    for cut in [1, 20, k / 2, k - 20, k - 1]
        if cut > 0 and cut < k
            let piece = bytes.slice(r, 0, cut)
            match x509csr.parse(piece, limits())
                Ok(_)  => test.fail("a request cut to ${cut} of ${k} bytes parsed")
                Err(e) =>
                    test.assert(x509err.is_malformed(e))
                    test.assert(x509err.error_offset(e) >= 0)

    test.case("trailing bytes are refused too, which is the same check from the other side")
    match x509cert.parse(leaf() + (bytes.from_hex("00") ?? bytes.zeros(0)), limits())
        Ok(_)  => test.fail("a certificate with a byte after it is not one certificate")
        Err(e) => test.assert_eq_str(x509err.code(e), "not-der")
    match x509crl.parse(crl_rich() + (bytes.from_hex("00") ?? bytes.zeros(0)), limits())
        Ok(_)  => test.fail("a list with a byte after it is not one list")
        Err(e) => test.assert_eq_str(x509err.code(e), "not-der")
    match x509csr.parse(csr_rich() + (bytes.from_hex("00") ?? bytes.zeros(0)), limits())
        Ok(_)  => test.fail("a request with a byte after it is not one request")
        Err(e) => test.assert_eq_str(x509err.code(e), "not-der")

@test
fn test_a_unique_id_is_a_bit_string_whose_universal_tag_was_replaced() [io]
    test.case("both present, and read as BIT STRINGs")
    let c = cert_of(unique_ids())
    match c.issuer_unique_id
        Some(b) =>
            test.assert_eq(b.unused_bits, 0)
            test.assert_eq_str(bytes.to_hex(b.data), "ff")
        None    => test.fail("the fixture carries an issuerUniqueID")
    match c.subject_unique_id
        Some(b) =>
            test.assert_eq(b.unused_bits, 3)
            test.assert_eq_str(bytes.to_hex(b.data), "a0")
        None    => test.fail("the fixture carries a subjectUniqueID")

    test.case("a certificate with neither answers None for both")
    let plain = cert_of(leaf())
    match plain.issuer_unique_id
        Some(_) => test.fail("the leaf carries no issuerUniqueID")
        None    => ()
    match plain.subject_unique_id
        Some(_) => test.fail("the leaf carries no subjectUniqueID")
        None    => ()

    test.case("empty content is impossible: a BIT STRING has at least the unused count")
    let blank = refusal(unique_blank(), "an empty uniqueID")
    test.assert_eq_str(x509err.code(blank), "impossible-field")
    test.assert(str.contains(blank.message(), "empty BIT STRING"))

    test.case("a non-zero unused count with nothing to be unused")
    let empty = refusal(unique_empty(), "a uniqueID with one unused bit and no content")
    test.assert_eq_str(x509err.code(empty), "impossible-field")
    test.assert(str.contains(empty.message(), "non-zero unused count"))

    test.case("more than seven unused bits, which no byte can express")
    let wide = refusal(unique_wide(), "a uniqueID claiming eight unused bits")
    test.assert_eq_str(x509err.code(wide), "impossible-field")
    test.assert(str.contains(wide.message(), "seven unused bits"))

    test.case("a constructed one, which X.690 forbids for a primitive type")
    let built = refusal(unique_constructed(), "a constructed uniqueID")
    test.assert_eq_str(x509err.code(built), "impossible-field")
    test.assert(str.contains(built.message(), "constructed BIT STRING"))

@test
fn test_a_name_is_written_the_way_rfc4514_writes_it() [io]
    let wide = cert_of(wide_name())

    test.case("the short names, and the empty string for a type with none")
    test.assert_eq_str(x509name.attribute_short_name(asn1oid.oid_common_name()), "CN")
    test.assert_eq_str(x509name.attribute_short_name(asn1oid.oid_country_name()), "C")
    test.assert_eq_str(x509name.attribute_short_name(x509name.oid_locality_name()), "L")
    test.assert_eq_str(x509name.attribute_short_name(x509name.oid_state_or_province_name()),
                       "ST")
    test.assert_eq_str(x509name.attribute_short_name(asn1oid.oid_organization_name()), "O")
    test.assert_eq_str(x509name.attribute_short_name(asn1oid.oid_organizational_unit_name()),
                       "OU")
    test.assert_eq_str(x509name.attribute_short_name(asn1oid.oid([2, 5, 4, 9])), "STREET")
    test.assert_eq_str(x509name.attribute_short_name(x509name.oid_domain_component()), "DC")
    test.assert_eq_str(x509name.attribute_short_name(asn1oid.oid([0, 9, 2342, 19200300, 100, 1, 1])),
                       "UID")
    test.case("the OIDs RFC 4514 has no short name for")
    test.assert_eq_str(x509name.attribute_short_name(x509name.oid_serial_number()), "")
    test.assert_eq_str(x509name.attribute_short_name(x509name.oid_dn_qualifier()), "")
    test.assert_eq_str(x509name.attribute_short_name(x509name.oid_email_address()), "")
    test.assert_eq_str(x509name.attribute_short_name(asn1oid.oid([1, 2, 3, 4])), "")

    test.case("the published OIDs are the ones the table is keyed by")
    test.assert_eq_str(asn1oid.oid_text(x509name.oid_locality_name()), "2.5.4.7")
    test.assert_eq_str(asn1oid.oid_text(x509name.oid_state_or_province_name()), "2.5.4.8")
    test.assert_eq_str(asn1oid.oid_text(x509name.oid_serial_number()), "2.5.4.5")
    test.assert_eq_str(asn1oid.oid_text(x509name.oid_dn_qualifier()), "2.5.4.46")
    test.assert_eq_str(asn1oid.oid_text(x509name.oid_domain_component()), "0.9.2342.19200300.100.1.25")
    test.assert_eq_str(asn1oid.oid_text(x509name.oid_email_address()), "1.2.840.113549.1.9.1")

    test.case("a fourteen-attribute name, escaped and reversed the way RFC 4514 says")
    // The encoding's order is outermost first; RFC 4514 section 2.1
    // prints it the other way round, so the common name comes out
    // first.  `#head` keeps its `#` behind a backslash, and the comma
    // in `Acme, Ltd` is escaped where it stands.  The three types with
    // no short name are written as dotted OIDs.
    test.assert_eq_str(x509name.to_rfc4514(x509cert.subject_of(wide)),
        "CN=\\#head,1.2.3.4=x,2.5.4.46=qual,1.2.840.113549.1.9.1=ops@example.com,2.5.4.5=42,UID=uid1234,DC=example,STREET=1 High St,O=Acme\\, Ltd,OU=Second,OU=First,ST=Greater London,L=London,C=GB")

    test.case("the escaping rule on its own, at both edges and in the middle")
    test.assert_eq_str(x509name.escape_rfc4514("Acme, Ltd"), "Acme\\, Ltd")
    test.assert_eq_str(x509name.escape_rfc4514("#head"), "\\#head")
    test.assert_eq_str(x509name.escape_rfc4514(" leading"), "\\ leading")
    test.assert_eq_str(x509name.escape_rfc4514("trailing "), "trailing\\ ")
    test.assert_eq_str(x509name.escape_rfc4514("a+b"), "a\\+b")
    test.assert_eq_str(x509name.escape_rfc4514("a;b<c>d\"e\\f"), "a\\;b\\<c\\>d\\\"e\\\\f")
    test.assert_eq_str(x509name.escape_rfc4514("plain"), "plain")
    test.assert_eq_str(x509name.escape_rfc4514(""), "")

    test.case("the attributes flattened out of their relative names, in encoding order")
    let attrs = x509name.attributes(x509cert.subject_of(wide))
    test.assert_eq(list.len(attrs), 14)
    test.assert_eq_str(asn1oid.oid_text(attrs[0].oid), "2.5.4.6")
    test.assert_eq_str(attrs[0].value, "GB")
    test.assert_eq_str(asn1oid.oid_text(attrs[13].oid), "2.5.4.3")
    test.assert_eq_str(attrs[13].value, "#head")

    test.case("a type carried twice answers BOTH values, not the first")
    let ous = x509name.attribute_values(x509cert.subject_of(wide),
                                        asn1oid.oid_organizational_unit_name())
    test.assert_eq(list.len(ous), 2)
    test.assert_eq_str(ous[0], "First")
    test.assert_eq_str(ous[1], "Second")
    test.assert_eq(list.len(x509name.attribute_values(x509cert.subject_of(wide),
                                                      asn1oid.oid([1, 2, 3, 4]))),
                                                      1)

    test.case("a name with no common name, and the empty name")
    let no_cn = cert_of(no_cn())
    match x509name.common_name(x509cert.subject_of(no_cn))
        Some(_) => test.fail("the subject is one organization attribute")
        None    => ()
    test.assert_eq(x509name.rdn_count(x509cert.subject_of(no_cn)), 1)
    test.assert(not x509name.is_empty(x509cert.subject_of(no_cn)))
    let empty = cert_of(empty_subject_crit())
    test.assert(x509name.is_empty(x509cert.subject_of(empty)))
    test.assert_eq(x509name.rdn_count(x509cert.subject_of(empty)), 0)

    test.case("a name comparison is NOT a string comparison: the case differs and the bytes differ")
    // `case_issuer`'s issuer is `CN=example ca` and the anchor's
    // subject is `CN=Example CA`.  Fold the case and the two RFC 4514
    // strings are equal; the comparison this package makes is over the
    // ENCODING, and it says they are different names.  A chain built on
    // a lowercased comparison accepts a certificate signed by somebody
    // whose name merely looks the same.
    let different = cert_of(case_issuer())
    let anchor_c = cert_of(anchor())
    test.assert_eq_str(str.lower(x509name.to_rfc4514(x509cert.issuer_of(different))),
                       str.lower(x509name.to_rfc4514(x509cert.subject_of(anchor_c))))
    test.assert(not x509name.issuer_matches_subject(case_issuer(),
                                                    x509cert.issuer_of(different),
                                                    anchor(),
                                                    x509cert.subject_of(anchor_c)))
    test.case("and the refusal a chain gets for it")
    match fault_under(case_issuer() + anchor(), trust_of(anchor()), policy(), p256(),
                      at(20100, 0, 0, 0))
        X509IssuerNotFound(index, issuer) =>
            test.assert_eq(index, 0)
            // Written as it was encoded: the case the two names differ in
            // is the case a string comparison would have folded away.
            test.assert_eq_str(issuer, "CN=example ca")
        _                                 => test.fail("a name that ENCODES differently is a different issuer")

    test.case("the span and the DER of a name")
    let span = x509name.name_span(x509cert.subject_of(wide))
    test.assert(span.off > 0)
    test.assert_eq(bytes.len(x509name.name_der(wide_name(), x509cert.subject_of(wide))),
                   span.len)
    test.assert_eq_str(bytes.to_hex(bytes.slice(wide_name(), span.off, span.off + span.len)),
                       bytes.to_hex(x509name.name_der(wide_name(), x509cert.subject_of(wide))))

// ── the signature check the caller supplies ─────────────────────────

@test
fn test_a_verifier_is_a_name_and_two_functions() [io]
    test.case("the verifier that implements nothing says so, in the algorithm's own name")
    let none = x509verify.no_verifier()
    test.assert_eq_str(x509verify.verifier_name(none), "none")
    test.assert(not x509verify.supports(none, asn1oid.oid_ecdsa_with_sha256()))
    test.assert(not x509verify.supports(none, asn1oid.oid_ed25519()))
    match x509verify.verify_certificate(none, x509cert.public_key_of(cert_of(anchor())),
                                        leaf(), cert_of(leaf()))
        Ok(o)  =>
            test.assert(not x509verify.outcome_is_good(o))
            test.assert(x509verify.outcome_is_uncheckable(o))
            test.assert_eq_str(x509verify.outcome_code(o), "uncheckable")
            match o
                X509SignatureUncheckable(algorithm) =>
                    test.assert_eq_str(algorithm, "ecdsa-with-SHA256")
                _                                   => test.fail("the empty verifier checks nothing and says so")
        Err(e) => test.fail(e.message())

    test.case("a verifier that implements one algorithm answers only for it")
    let v = p256()
    test.assert_eq_str(x509verify.verifier_name(v), "p256")
    test.assert(x509verify.supports(v, asn1oid.oid_ecdsa_with_sha256()))
    test.assert(not x509verify.supports(v, asn1oid.oid_ed25519()))
    test.assert(x509verify.supports(ed25519_ok(), asn1oid.oid_ed25519()))
    test.assert(not x509verify.supports(ed25519_ok(), asn1oid.oid_ecdsa_with_sha256()))

    test.case("two verifiers put together ask the first that supports the algorithm")
    let both = x509verify.combined(p256_bad(), ed25519_ok())
    test.assert_eq_str(x509verify.verifier_name(both), "bad-p256+ed25519")
    test.assert_eq_str(x509verify.verifier_name(x509verify.combined(p256(), ed25519_ok())),
                       "p256+ed25519")
    test.assert(x509verify.supports(both, asn1oid.oid_ecdsa_with_sha256()))
    test.assert(x509verify.supports(both, asn1oid.oid_ed25519()))
    test.case("the answer is the first one's for its algorithm, the second's for its own")
    test.assert_eq_str(x509verify.outcome_code(x509verify.verify_signature(both, ecdsa_alg(),
                       x509cert.public_key_of(cert_of(leaf())), bytes.zeros(0), bytes.zeros(0))),
                       "bad")
    test.assert_eq_str(x509verify.outcome_code(x509verify.verify_signature(both,
                       alg_of(asn1oid.oid_ed25519()),
                       x509cert.public_key_of(cert_of(leaf())), bytes.zeros(0), bytes.zeros(0))),
                       "good")
    test.case("an algorithm neither implements is not supported, and falls to the second")
    // `verify_signature` does not consult `supports`: the second
    // verifier is asked because the first said no, and a pair that
    // wants to refuse an unknown algorithm in words uses `supports`.
    test.assert(not x509verify.supports(both, asn1oid.oid_sha256_with_rsa()))
    test.assert_eq_str(x509verify.outcome_code(x509verify.verify_signature(both,
                       alg_of(asn1oid.oid_sha256_with_rsa()),
                       x509cert.public_key_of(cert_of(leaf())), bytes.zeros(0), bytes.zeros(0))),
                       "good")

    test.case("checking a certificate, a list and a request")
    match x509verify.verify_certificate(p256(), x509cert.public_key_of(cert_of(anchor())),
                                        leaf(), cert_of(leaf()))
        Ok(o)  =>
            test.assert(x509verify.outcome_is_good(o))
            test.assert_eq_str(x509verify.outcome_code(o), "good")
        Err(e) => test.fail(e.message())
    match x509verify.verify_crl(ed25519_ok(), x509cert.public_key_of(cert_of(anchor())),
                                crl_rich(), crl_of(crl_rich()))
        Ok(o)  => test.assert(x509verify.outcome_is_good(o))
        Err(e) => test.fail(e.message())
    match x509verify.verify_csr(p256(), csr_rich(), csr_of(csr_rich()))
        Ok(o)  => test.assert(x509verify.outcome_is_good(o))
        Err(e) => test.fail(e.message())

    test.case("a certificate is self-signed when its own key verifies it — a different question")
    match x509verify.is_self_signed(p256(), anchor(), cert_of(anchor()))
        Ok(o)  => test.assert(x509verify.outcome_is_good(o))
        Err(e) => test.fail(e.message())
    match x509verify.is_self_signed(p256(), leaf(), cert_of(leaf()))
        Ok(o)  => test.assert(x509verify.outcome_is_good(o))
        Err(e) => test.fail(e.message())

    test.case("the document's own problem is an Err, before any verifier is asked")
    match x509verify.verify_certificate(p256(), x509cert.public_key_of(cert_of(anchor())),
                                        params(), cert_of(params()))
        Err(e) => test.assert_eq_str(x509err.code(e), "algorithm-mismatch")
        Ok(_)  => test.fail("the two algorithm identifiers disagree")
    match x509verify.verify_certificate(p256(), x509cert.public_key_of(cert_of(anchor())),
                                        unsigned_bits(), cert_of(unsigned_bits()))
        Err(e) => test.assert_eq_str(x509err.code(e), "impossible-field")
        Ok(_)  => test.fail("a signature with unused bits is not a signature")
    match x509verify.verify_crl(p256(), x509cert.public_key_of(cert_of(anchor())),
                                crl_unsigned_bits(), crl_of(crl_unsigned_bits()))
        Err(e) => test.assert_eq_str(x509err.code(e), "impossible-field")
        Ok(_)  => test.fail("a signature with unused bits is not a signature")
    match x509verify.verify_csr(p256(), csr_unsigned_bits(), csr_of(csr_unsigned_bits()))
        Err(e) => test.assert_eq_str(x509err.code(e), "impossible-field")
        Ok(_)  => test.fail("a signature with unused bits is not a signature")

@test
fn test_an_algorithm_is_named_before_it_is_blamed() [io]
    test.assert_eq_str(x509verify.algorithm_name(ecdsa_alg()), "ecdsa-with-SHA256")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(x509verify.oid_ecdsa_with_sha384())),
                       "ecdsa-with-SHA384")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(x509verify.oid_ecdsa_with_sha512())),
                       "ecdsa-with-SHA512")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(asn1oid.oid_ed25519())), "Ed25519")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(asn1oid.oid_sha256_with_rsa())),
                       "sha256WithRSAEncryption")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(x509verify.oid_sha1_with_rsa())),
                       "sha1WithRSAEncryption")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(x509verify.oid_sha384_with_rsa())),
                       "sha384WithRSAEncryption")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(x509verify.oid_sha512_with_rsa())),
                       "sha512WithRSAEncryption")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(x509verify.oid_rsassa_pss())),
                       "RSASSA-PSS")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(asn1oid.oid_rsa_encryption())),
                       "rsaEncryption")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(asn1oid.oid_ec_public_key())),
                       "id-ecPublicKey")
    test.case("an algorithm this package has never heard of is named by its OID, not by blank")
    test.assert_eq_str(x509verify.algorithm_name(alg_of(asn1oid.oid([1, 2, 3, 4]))), "1.2.3.4")

    test.case("the RSA family, named because nothing here implements it")
    test.assert(x509verify.is_rsa_algorithm(alg_of(asn1oid.oid_sha256_with_rsa())))
    test.assert(x509verify.is_rsa_algorithm(alg_of(x509verify.oid_sha1_with_rsa())))
    test.assert(x509verify.is_rsa_algorithm(alg_of(x509verify.oid_sha384_with_rsa())))
    test.assert(x509verify.is_rsa_algorithm(alg_of(x509verify.oid_sha512_with_rsa())))
    test.assert(x509verify.is_rsa_algorithm(alg_of(x509verify.oid_rsassa_pss())))
    test.assert(x509verify.is_rsa_algorithm(alg_of(asn1oid.oid_rsa_encryption())))
    test.assert(not x509verify.is_rsa_algorithm(ecdsa_alg()))
    test.assert(not x509verify.is_rsa_algorithm(alg_of(asn1oid.oid_ed25519())))

    test.case("the OIDs asn1oid does not publish, dotted out")
    test.assert_eq_str(asn1oid.oid_text(x509verify.oid_ecdsa_with_sha384()),
                       "1.2.840.10045.4.3.3")
    test.assert_eq_str(asn1oid.oid_text(x509verify.oid_ecdsa_with_sha512()),
                       "1.2.840.10045.4.3.4")
    test.assert_eq_str(asn1oid.oid_text(x509verify.oid_sha1_with_rsa()), "1.2.840.113549.1.1.5")
    test.assert_eq_str(asn1oid.oid_text(x509verify.oid_sha384_with_rsa()),
                       "1.2.840.113549.1.1.12")
    test.assert_eq_str(asn1oid.oid_text(x509verify.oid_sha512_with_rsa()),
                       "1.2.840.113549.1.1.13")
    test.assert_eq_str(asn1oid.oid_text(x509verify.oid_rsassa_pss()), "1.2.840.113549.1.1.10")

    test.case("a refusal that names the algorithm, so a report says which one went unchecked")
    match fault_under(chain(), trust_of(anchor()), x509path.strict(), x509verify.no_verifier(),
                      at(20100, 0, 0, 0))
        X509NoVerifierForAlgorithm(index, algorithm) =>
            test.assert_eq(index, 0)
            test.assert_eq_str(algorithm, "ecdsa-with-SHA256")
        _                                            => test.fail("strict() requires every signature checked")

// ── the path ────────────────────────────────────────────────────────

@test
fn test_a_chain_validates_against_an_anchor_at_an_instant_the_caller_supplies() [io]
    let src = chain()
    let trust = trust_of(anchor())

    test.case("the answer says what it got, and not merely that it got something")
    match x509path.validate(src, certs_of(src), trust, x509verify.no_verifier(),
                            at(20100, 0, 0, 0), policy())
        Ok(p)  =>
            test.assert_eq(x509path.path_length(p), 2)
            test.assert_eq(list.len(p.certificates), 2)
            test.assert_eq(list.len(x509path.unchecked_of(p)), 2)
            test.assert_eq(x509path.unchecked_of(p)[0], 0)
            test.assert_eq(x509path.unchecked_of(p)[1], 1)
            test.assert(not x509path.is_fully_checked(p))
            test.assert_eq(list.len(x509path.policies_of(p)), 0)
            test.assert_eq_str(x509cert.serial_hex(x509path.leaf_of(p)), "0a")
            let a = x509path.anchor_of(p)
            test.assert_eq_str(bytes.to_hex(a.der), bytes.to_hex(anchor()))
            test.assert_eq(x509cert.version_of(a.cert), 3)
        Err(e) => test.fail("the chain reaches its anchor: ${e.message()}")

    test.case("with a verifier that implements the algorithm, nothing is unchecked")
    match x509path.validate(src, certs_of(src), trust, p256(), at(20100, 0, 0, 0), policy())
        Ok(p)  =>
            test.assert_eq(list.len(x509path.unchecked_of(p)), 0)
            test.assert(x509path.is_fully_checked(p))
        Err(e) => test.fail(e.message())

    test.case("and a verifier that refuses the signature is a refusal at the leaf's index")
    match x509path.validate(src, certs_of(src), trust, p256_bad(), at(20100, 0, 0, 0), policy())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "signature-invalid")
            test.assert_eq(x509err.error_index(e), 0)
        Ok(_)  => test.fail("the verifier says the signature does not verify")

    test.case("the two-moment convenience that parses and validates in one call")
    match x509path.validate_der(src, trust, p256(), at(20100, 0, 0, 0), policy(), limits())
        Ok(p)  => test.assert_eq(x509path.path_length(p), 2)
        Err(e) => test.fail(e.message())
    match x509path.validate_der(bytes.from_hex("020107") ?? bytes.zeros(0), trust, p256(),
                                at(20100, 0, 0, 0), policy(), limits())
        Err(e) => test.assert_eq_str(x509err.code(e), "not-der")
        Ok(_)  => test.fail("an INTEGER is not a chain")
    match x509path.validate_der(bytes.from_hex("3003020107") ?? bytes.zeros(0), trust, p256(),
                                at(20100, 0, 0, 0), policy(), limits())
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "missing-field")
            test.assert(str.contains(e.message(), "signatureAlgorithm"))
        Ok(_)  => test.fail("a SEQUENCE holding an INTEGER is not a certificate")

    test.case("a policy that is unusable says so before anything is looked at")
    let unusable_policy = x509path.with_max_chain_length(x509path.strict(), 0)
    match x509path.check_policy(unusable_policy)
        Some(e) => test.assert_eq_str(x509err.code(e), "policy-unusable")
        None    => test.fail("a maximum chain length below one can never reach an anchor")
    match x509path.check_policy(x509path.strict())
        Some(e) => test.fail("strict() is usable: ${e.message()}")
        None    => ()
    test.assert_eq(x509path.X509_MAX_CHAIN_DEFAULT, 8)

    test.case("the policy's own bound, which is not a rule of RFC 5280")
    match x509path.validate(src, certs_of(src), trust, p256(), at(20100, 0, 0, 0),
                            x509path.with_max_chain_length(x509path.strict(), 1))
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "chain-too-long")
            match e
                X509ChainTooLong(length, limit) =>
                    test.assert_eq(length, 2)
                    test.assert_eq(limit, 1)
                _                               => ()
        Ok(_)  => test.fail("two certificates are over a bound of one")

    test.case("the instant is an argument here too, and the SAME call moves with it")
    test.assert(validates(src, trust, policy(), p256(), at(20089, 0, 0, 0)))
    test.assert(validates(src, trust, policy(), p256(), at(20200, 0, 0, 0)))
    test.assert(not validates(src, trust, policy(), p256(), at(20088, 23, 59, 59)))
    test.assert(not validates(src, trust, policy(), p256(), at(20455, 0, 0, 0)))
    test.case("and a policy that stops asking still needs the chain to be a chain")
    test.assert(validates(src, trust,
                          x509path.without_validity_check(x509path.strict()), p256(),
                          at(20088, 0, 0, 0)))
    test.assert(validates(src, trust,
                          x509path.without_validity_check(x509path.strict()), p256(),
                          at(20455, 0, 0, 0)))

@test
fn test_name_constraints_and_purposes_are_checked_down_the_chain() [io]
    test.case("a leaf whose names fall outside the anchor's constraint")
    match fault_under(chain_org(), trust_of(constrained_anchor()), x509path.strict(),
                      p256(), at(20100, 0, 0, 0))
        X509NameConstraintViolated(index, name) =>
            test.assert_eq(index, 0)
            test.assert_eq_str(name, "DNS:example.org")
        _                                       => test.fail("the constrained anchor permits example.com only")

    test.case("the same chain under a policy that stops enforcing them")
    test.assert(validates(chain_org(), trust_of(constrained_anchor()),
                          x509path.without_name_constraints(x509path.strict()), p256(),
                          at(20100, 0, 0, 0)))

    test.case("a constraint written on the anchor itself is applied to the certificate below it")
    // The anchor's own names are NOT checked: `validate` asserts the
    // names of the chain, and the anchor is where the walk stops.
    // `chain()` terminates at a SECOND anchor: the ANCHOR certificate
    // in the chain is itself a chain member, and its own directory
    // name is on the constrained anchor's excluded list.
    match fault_under(chain(), trust_of(constrained_anchor()), x509path.strict(), p256(),
                      at(20100, 0, 0, 0))
        X509NameConstraintViolated(index, name) =>
            test.assert_eq(index, 1)
            test.assert(str.contains(name, "CN=Example CA"))
        _                                       => test.fail("the anchor's own name is excluded by the constrained anchor")

    test.case("names_permitted asks the same question of names a caller holds")
    let c = [rich_constraints()]
    test.assert(x509path.names_permitted(c, [X509DnsName(name: "www.example.com")]))
    test.assert(not x509path.names_permitted(c, [X509DnsName(name: "www.example.org")]))
    test.assert(not x509path.names_permitted(c, [X509DnsName(name: "bad.example.com")]))
    test.assert(not x509path.names_permitted(c, [X509DnsName(name: "deep.bad.example.com")]))
    test.assert(not x509path.names_permitted(c, [X509EmailAddress(address: "x@spam.example")]))
    test.assert(x509path.names_permitted(c, [X509OtherName(oid: asn1oid.oid([1, 2]),
                                                           value: bytes.zeros(0))]))
    test.assert(x509path.names_permitted(c, [X509UnsupportedName(tag: 3,
                                                                 value: bytes.zeros(0))]))
    test.assert(x509path.names_permitted([], [X509DnsName(name: "anything.at.all")]))

    test.case("a purpose the certificate must carry, and one it does not")
    // The leaf carries no extKeyUsage at all, which is no restriction.
    test.assert(validates(chain(), trust_of(anchor()),
                          x509path.requiring_key_purpose(x509path.strict(),
                                                         x509ext.oid_kp_server_auth()),
                          p256(), at(20100, 0, 0, 0)))
    test.case("and the refusal when the certificate names purposes and not this one")
    let org = x509path.requiring_key_purpose(x509path.strict(), x509ext.oid_kp_server_auth())
    test.assert(validates(leaf_org() + anchor(), trust_of(anchor()), org, p256(),
                          at(20100, 0, 0, 0)))
    let ocsp = x509path.requiring_key_purpose(x509path.strict(), x509ext.oid_kp_ocsp_signing())
    let with_purposes = rich() + anchor()
    test.case("the rich certificate names server and client auth, and not OCSP signing")
    match fault_under(with_purposes, trust_of(anchor()), ocsp, p256(), at(20100, 0, 0, 0))
        X509KeyPurposeNotPermitted(index, purpose) =>
            test.assert_eq(index, 0)
            test.assert_eq_str(purpose, "1.3.6.1.5.5.7.3.9")
        _                                          => test.fail("the rich certificate carries an extKeyUsage without this purpose")
    test.case("and the same certificate passes for a purpose it does name")
    test.assert(validates(with_purposes, trust_of(anchor()),
                          x509path.requiring_key_purpose(x509path.strict(),
                                                         x509ext.oid_kp_server_auth()),
                          p256(), at(20100, 0, 0, 0)))

    test.case("the CA rules, asked of one certificate with an index and a role")
    let leaf_c = cert_of(leaf())
    match x509path.check_certificate(leaf(), leaf_c, 0, true, at(20100, 0, 0, 0),
                                     x509path.strict(), limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "not-a-ca")
            test.assert_eq(x509err.error_index(e), 0)
        None    => test.fail("the leaf signed something and carries no basicConstraints")
    match x509path.check_certificate(anchor(), cert_of(anchor()), 1, true, at(20100, 0, 0, 0),
                                     x509path.strict(), limits())
        Some(e) => test.fail("the anchor may sign: ${e.message()}")
        None    => ()
    test.case("and the CA flag is not asked of a certificate that signed nothing")
    match x509path.check_certificate(leaf(), leaf_c, 0, false, at(20100, 0, 0, 0),
                                     x509path.strict(), limits())
        Some(e) => test.fail("the leaf is an end entity here: ${e.message()}")
        None    => ()

    test.case("a policy that checks the shape and almost nothing else")
    test.assert(validates(chain_org(), trust_of(constrained_anchor()), x509path.permissive(),
                          x509verify.no_verifier(), at(20500, 0, 0, 0)))
    test.assert(not x509path.permissive().require_ca_flag)
    test.assert(x509path.strict().require_ca_flag)
    test.assert_eq(list.len(x509path.permissive().known_extension_oids), 1)
    test.case("and a caller's own extension makes a critical one recognized")
    let knowing = x509path.knowing_extensions(x509path.strict(),
                                              [asn1oid.oid([1, 3, 6, 1, 4, 1, 9999, 1])])
    test.assert_eq(list.len(knowing.known_extension_oids), 1)
    test.assert(validates(unknown_critical() + anchor(), trust_of(anchor()), knowing, p256(),
                          at(20100, 0, 0, 0)))
    test.case("and it is refused under the same policy that does not name it")
    match fault_under(unknown_critical() + anchor(), trust_of(anchor()), policy(), p256(),
                      at(20100, 0, 0, 0))
        X509UnknownCriticalExtension(index, oid) =>
            test.assert_eq(index, 0)
            test.assert_eq_str(oid, "1.3.6.1.4.1.9999.1")
        _                                        => test.fail("1.3.6.1.4.1.9999.1 is not implemented here")

@test
fn test_a_bag_of_certificates_is_put_in_order_and_matched_to_a_host() [io]
    let src = chain()

    test.case("the order check compares adjacent names and nothing else")
    match x509path.check_chain_order(src, certs_of(src))
        Some(e) => test.fail("the chain is in order: ${e.message()}")
        None    => ()
    match x509path.check_chain_order(chain_reversed(), certs_of(chain_reversed()))
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "issuer-not-found")
            test.assert_eq(x509err.error_index(e), 0)
        None    => test.fail("the reversed chain is not in order")
    test.case("and one certificate is trivially in order")
    match x509path.check_chain_order(leaf(), certs_of(leaf()))
        Some(e) => test.fail("one certificate has nothing to be out of order with: ${e.message()}")
        None    => ()

    test.case("building the chain from a pool, in whichever order the pool was given")
    let pool = certs_of(src)
    match x509path.build_chain(src, cert_of(leaf()), pool, trust_of(anchor()))
        Ok(chain_out) =>
            test.assert_eq(list.len(chain_out), 2)
            test.assert_eq_str(x509cert.serial_hex(chain_out[0]), "0a")
            test.assert_eq_str(x509cert.serial_hex(chain_out[1]), "01")
        Err(e)        => test.fail(e.message())
    test.case("a pool that names the leaf twice still builds a chain of two")
    let dup_pool = certs_of(chain_dup())
    test.assert_eq(list.len(dup_pool), 3)
    match x509path.build_chain(chain_dup(), dup_pool[0], dup_pool, trust_of(anchor()))
        Ok(chain_out) =>
            test.assert_eq(list.len(chain_out), 2)
            test.assert_eq_str(x509cert.serial_hex(chain_out[0]), "0a")
            test.assert_eq_str(x509cert.serial_hex(chain_out[1]), "01")
        Err(e)        => test.fail(e.message())
    test.case("a pool with no issuer in it, and a trust set that cannot terminate it")
    match x509path.build_chain(leaf(), cert_of(leaf()), [], trust_of(leaf()))
        Err(e) =>
            test.assert_eq_str(x509err.code(e), "issuer-not-found")
            test.assert_eq(x509err.error_index(e), 0)
            test.assert(str.contains(e.message(), "Example CA"))
        Ok(_)  => test.fail("nothing in that pool issued the leaf")

    test.case("the trust set answers how many anchors it holds, and gives them back")
    let t = trust_of(anchor())
    test.assert_eq(x509path.anchor_count(t), 1)
    test.assert_eq(list.len(x509path.anchors_of(t)), 1)
    test.assert_eq(x509path.anchor_count(x509path.empty_trust_set()), 0)
    let two = x509path.with_anchor(t, anchor_of(leaf()))
    test.assert_eq(x509path.anchor_count(two), 2)
    test.assert_eq(x509path.anchor_count(t), 1)
    test.case("an anchor's DER is carried inside it")
    match x509path.anchor(leaf(), limits())
        Ok(a)  => test.assert_eq_str(bytes.to_hex(a.der), bytes.to_hex(leaf()))
        Err(e) => test.fail(e.message())
    match x509path.anchor(bytes.from_hex("020107") ?? bytes.zeros(0), limits())
        Err(e) => test.assert_eq_str(x509err.code(e), "not-der")
        Ok(_)  => test.fail("an INTEGER is not a certificate")
    match x509path.anchor(bytes.from_hex("3003020107") ?? bytes.zeros(0), limits())
        Err(e) => test.assert_eq_str(x509err.code(e), "missing-field")
        Ok(_)  => test.fail("a SEQUENCE holding an INTEGER is not a certificate")

    test.case("matching a host: the wildcard matches ONE label, leftmost only")
    let ns = leaf_names()
    test.assert(x509path.matches_hostname(ns, "example.com"))
    test.assert(x509path.matches_hostname(ns, "a.example.com"))
    test.assert(x509path.matches_hostname(ns, "EXAMPLE.COM"))
    test.assert(x509path.matches_hostname(ns, "A.Example.Com"))
    test.assert(not x509path.matches_hostname(ns, "a.b.example.com"))
    test.assert(not x509path.matches_hostname(ns, "notexample.com"))
    test.assert(not x509path.matches_hostname(ns, "example.org"))
    test.assert(not x509path.matches_hostname(ns, ""))
    test.case("a name of another form never matches a host")
    test.assert(not x509path.matches_hostname([X509EmailAddress(address: "ops@example.com")],
                                              "example.com"))
    test.assert(not x509path.matches_hostname([], "example.com"))

// ── every value a reader is handed on its own ───────────────────────

// A reader for an extension takes the value its OID names.  The
// documents above are malformed where a certificate writer gets the
// structure wrong; these are malformed INSIDE a value, which is the
// place nothing else can check: an extension's value is an OCTET
// STRING, so until the reader for its OID looks, every byte of it is
// as opaque as any other, and the length it claims is a length an
// attacker wrote.
//
// Each case below hands one reader one value, and the reader must
// refuse it rather than read the part it recognizes.
@test
fn test_every_value_reader_refuses_a_value_that_is_not_its_structure() [io]
    test.case("a general name whose child is not a context tag, or a form nothing names")
    refuses(x509ext.subject_alt_name(
                [ext_value(asn1oid.oid_subject_alt_name(), san_universal_child())], limits()),
            "2.5.29.17")
    refuses(x509ext.subject_alt_name(
                [ext_value(asn1oid.oid_subject_alt_name(), san_tag_nine())], limits()),
            "2.5.29.17")

    test.case("an otherName with a type and no value")
    refuses(x509ext.subject_alt_name(
                [ext_value(asn1oid.oid_subject_alt_name(), san_othername_one())], limits()),
            "2.5.29.17")

    test.case("an IA5String with a byte above 127, which is not seven-bit IA5")
    refuses(x509ext.subject_alt_name(
                [ext_value(asn1oid.oid_subject_alt_name(), san_high_byte())], limits()),
            "2.5.29.17")

    test.case("a name constraint whose child is neither permittedSubtrees nor excludedSubtrees")
    refuses(x509ext.name_constraints(
                [ext_value(x509ext.oid_name_constraints(), nc_child_tag2())], limits()),
            "2.5.29.30")

    test.case("the two bounds of a subtree, read as the distances they are")
    match x509ext.name_constraints(
            [ext_value(x509ext.oid_name_constraints(), nc_min_steps())], limits())
        Ok(Some(c)) =>
            test.assert_eq(list.len(c.permitted), 1)
            test.assert_eq(c.permitted[0].minimum, 2)
            test.assert_eq(c.permitted[0].maximum, -1)
        Ok(None)    => test.fail("the value carries a permitted subtree")
        Err(e)      => test.fail(e.message())
    match x509ext.name_constraints(
            [ext_value(x509ext.oid_name_constraints(), nc_max_steps())], limits())
        Ok(Some(c)) => test.assert_eq(c.permitted[0].maximum, 2)
        Ok(None)    => test.fail("the value carries a permitted subtree")
        Err(e)      => test.fail(e.message())
    match x509ext.name_constraints(
            [ext_value(x509ext.oid_name_constraints(), nc_one_subtree())], limits())
        Ok(Some(c)) => test.assert_eq(c.permitted[0].minimum, 0)
        Ok(None)    => test.fail("the value carries a permitted subtree")
        Err(e)      => test.fail(e.message())

    test.case("a subtree with no base at all, and one bounded by a byte a distance cannot be")
    refuses(x509ext.name_constraints(
                [ext_value(x509ext.oid_name_constraints(), nc_empty_subtree())], limits()),
            "2.5.29.30")
    refuses(x509ext.name_constraints(
                [ext_value(x509ext.oid_name_constraints(), nc_min_empty())], limits()),
            "2.5.29.30")
    refuses(x509ext.name_constraints(
                [ext_value(x509ext.oid_name_constraints(), nc_min_leading_zero())], limits()),
            "2.5.29.30")

    test.case("a third bound, and a child that is not a context tag at all")
    refuses(x509ext.name_constraints(
                [ext_value(x509ext.oid_name_constraints(), nc_tag_two())], limits()),
            "2.5.29.30")
    refuses(x509ext.name_constraints(
                [ext_value(x509ext.oid_name_constraints(), nc_universal_child())], limits()),
            "2.5.29.30")

    test.case("a distribution point whose child is not a context tag")
    refuses(x509ext.crl_distribution_points(
                [ext_value(x509ext.oid_crl_distribution_points(), dp_universal_child())],
                limits()),
            "2.5.29.31")

    test.case("a DistributionPointName holding two names, and one holding the wrong CHOICE")
    refuses(x509ext.crl_distribution_points(
                [ext_value(x509ext.oid_crl_distribution_points(), dp_two_names())], limits()),
            "2.5.29.31")
    refuses(x509ext.crl_distribution_points(
                [ext_value(x509ext.oid_crl_distribution_points(), dp_wrong_choice())], limits()),
            "2.5.29.31")

    test.case("a ReasonFlags that is constructed, empty, or more than seven bits wide")
    refuses(x509ext.crl_distribution_points(
                [ext_value(x509ext.oid_crl_distribution_points(), dp_reasons_constructed())],
                limits()),
            "2.5.29.31")
    refuses(x509ext.crl_distribution_points(
                [ext_value(x509ext.oid_crl_distribution_points(), dp_reasons_empty())], limits()),
            "2.5.29.31")
    refuses(x509ext.crl_distribution_points(
                [ext_value(x509ext.oid_crl_distribution_points(), dp_reasons_wide())], limits()),
            "2.5.29.31")

    test.case("a relative name written out of order, and one whose attribute is half there")
    refuses(x509ext.crl_distribution_points(
                [ext_value(x509ext.oid_crl_distribution_points(), dp_relative_unsorted())],
                limits()),
            "2.5.29.31")
    refuses(x509ext.crl_distribution_points(
                [ext_value(x509ext.oid_crl_distribution_points(), dp_relative_one())], limits()),
            "2.5.29.31")

    test.case("and the point that is written the way the module says")
    match x509ext.crl_distribution_points(
            [ext_value(x509ext.oid_crl_distribution_points(), dp_uris())], limits())
        Ok(Some(points)) =>
            test.assert_eq(list.len(points), 1)
            test.assert_eq(list.len(points[0].full_name), 1)
            test.assert_eq_str(x509ext.general_name_text(points[0].full_name[0]),
                               "URI:https://crl.example.com/x")
        Ok(None)         => test.fail("the value names a distribution point")
        Err(e)           => test.fail(e.message())

    test.case("a policy with no OID, and a qualifier with no value")
    refuses(x509ext.certificate_policies(
                [ext_value(x509ext.oid_certificate_policies(), pol_empty_info())], limits()),
            "2.5.29.32")
    refuses(x509ext.certificate_policies(
                [ext_value(x509ext.oid_certificate_policies(), pol_qualifier_one())], limits()),
            "2.5.29.32")

    test.case("a CA flag that is not a BOOLEAN and not an INTEGER")
    refuses(x509ext.basic_constraints(
                [ext_value(asn1oid.oid_basic_constraints(), bc_ia5_child())], limits()),
            "2.5.29.19")

    test.case("an authority key identifier whose child is a universal tag or an unused number")
    refuses(x509ext.authority_key_identifier(
                [ext_value(x509ext.oid_authority_key_identifier(), aki_universal_child())],
                limits()),
            "2.5.29.35")
    refuses(x509ext.authority_key_identifier(
                [ext_value(x509ext.oid_authority_key_identifier(), aki_tag_three())], limits()),
            "2.5.29.35")

// ── the rules a link asks of the certificate above it ───────────────

// Whether a certificate that signed something may have signed it is a
// question about its POSITION and not only about itself: the
// end-entity certificate of a chain signed nothing, so demanding a CA
// flag of it refuses every ordinary chain, while a certificate one
// step above it signed the leaf and must answer.  `check_certificate`
// is that question, and `link` is the same question plus the names and
// the signature.
@test
fn test_the_rules_a_certificate_meets_depend_on_where_it_sits() [io]
    let week = at(20100, 0, 0, 0)

    test.case("an issuer whose own extensions do not parse stops the link it was written for")
    // The names carry `_refusal` because a local that takes the name of
    // a fixture turns that fixture's call into an indirect call through
    // the local's own slot, which is a SIGSEGV rather than a refusal
    // (novo bug codegen-llvm/a-call-to-a-name-bound-to-a-local-is-emitted-as-an-indirect-call-through-the).
    let bad_bc_refusal = fault(chain_bad_bc(), trust_of(anchor()))
    test.assert_eq_str(x509err.code(bad_bc_refusal), "bad-extension-value")
    test.assert(str.contains(bad_bc_refusal.message(), "2.5.29.19"))
    let bad_ku_refusal = fault(chain_bad_ku(), trust_of(anchor()))
    test.assert_eq_str(x509err.code(bad_ku_refusal), "bad-extension-value")
    test.assert(str.contains(bad_ku_refusal.message(), "2.5.29.15"))

    test.case("a policy that does not ask for the CA flag still asks for a path length it can read")
    // The three checks of a link are gated separately, and the gate
    // that is shut must not hide the ones behind it: this policy turns
    // the first two off and the third still reads the extension.
    let out = fault_under(chain_bad_bc(), trust_of(anchor()), link_rules(),
                          x509verify.no_verifier(), week)
    test.assert_eq_str(x509err.code(out), "bad-extension-value")
    test.assert(str.contains(out.message(), "2.5.29.19"))

    test.case("a signature refused for its identifiers is a fault of the link, not unchecked")
    let mismatch = fault(params() + anchor(), trust_of(anchor()))
    test.assert_eq_str(x509err.code(mismatch), "algorithm-mismatch")
    test.assert(not x509err.is_malformed(mismatch))

    test.case("asked of the certificate rather than of the link: a purpose the leaf must carry")
    let purpose = x509path.requiring_key_purpose(policy(), x509ext.oid_kp_server_auth())
    match x509path.check_certificate(bad_eku(), cert_of(bad_eku()), 0, false, week,
                                     purpose, limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.37"))
        None    => test.fail("an IA5String is not an ExtKeyUsageSyntax")

    test.case("and the CA flag, the key usage and keyCertSign, each asked only of an issuer")
    match x509path.check_certificate(bad_bc(), cert_of(bad_bc()), 0, true, week,
                                     policy(), limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.19"))
        None    => test.fail("an IA5String is not a BasicConstraints")
    match x509path.check_certificate(bad_ku(), cert_of(bad_ku()), 0, true, week,
                                     policy(), limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "bad-extension-value")
            test.assert(str.contains(e.message(), "2.5.29.15"))
        None    => test.fail("an IA5String is not a KeyUsage")
    match x509path.check_certificate(no_ks_mid(), cert_of(no_ks_mid()), 1, true, week,
                                     policy(), limits())
        Some(e) =>
            test.assert_eq_str(x509err.code(e), "key-cert-sign-not-permitted")
            test.assert_eq(x509err.error_index(e), 1)
        None    => test.fail("a CA whose key usage forbids signing certificates has signed one")
    // The same certificate as the END ENTITY is asked none of those
    // three, which is the whole reason `is_issuer` is a parameter.
    match x509path.check_certificate(no_ks_mid(), cert_of(no_ks_mid()), 0, false, week,
                                     policy(), limits())
        Some(e) => test.fail("the leaf of a chain is not asked to be a CA: ${e.message()}")
        None    => ()
