// x509csr — a PKCS #10 certification request, read.
//
// WHAT A CERTIFICATION REQUEST IS.  RFC 2986 — PKCS #10 — is how
// somebody asks a CA for a certificate.  The request carries the name
// the requester wants, the PUBLIC key it wants certified, and a set of
// attributes; it is signed with the matching PRIVATE key, and that
// signature is the whole point.  It is a proof of possession: it says
// that whoever asked for this certificate holds the private key for
// the public one inside it, so a CA cannot be tricked into certifying
// somebody else's key under the requester's name.
//
// THE STRUCTURE IS THE SAME THREE PARTS AGAIN.  A
// `CertificationRequestInfo` holding version, subject, public key and
// attributes; an algorithm identifier; a signature over the first.  So
// `info` is a span into the caller's bytes for exactly the reason
// `X509Cert.tbs` is, and `info_bytes` is the one call that copies.
//
// THE CA DECIDES, NOT THE REQUESTER.  Everything in the request is a
// REQUEST.  The extensions it asks for arrive in an attribute and are
// what the requester would like; a CA that copied them into the
// certificate without looking would let anyone ask for a CA
// certificate and get one.  This package reads them and says so, and
// the naming says so: `requested_extensions`, never `extensions`.
//
// THIS PACKAGE DOES NOT ISSUE ANYTHING.  Turning a request into a
// certificate means choosing a serial number, a validity period and an
// extension set, encoding a tbsCertificate and signing it — which is a
// CA, and a CA is a program with a policy, a key store and an audit
// log rather than a parser.  The README names it as out of scope.

use std.bytes
use asn1oid
use asn1pkix
use asn1read
use asn1univ
use x509err
use x509ext
use x509name

// The version of a PKCS #10 request.
//
// RFC 2986 defines one, and its encoded value is 0.  Unlike a
// certificate's, this number is NOT written one higher: a v1 request
// carries the integer 0, and a reader that added one would refuse
// every request in the world.
pub const X509_CSR_VERSION_1 = 0

// `1.2.840.113549.1.9.14` — `extensionRequest`, the PKCS #9 attribute
// carrying the extensions the requester would like.  Defined in RFC
// 2985, and the attribute a subject alternative name travels in.
pub fn oid_extension_request() -> AsnOid []
    asn1oid.oid([1, 2, 840, 113549, 1, 9, 14])

// `1.2.840.113549.1.9.7` — `challengePassword`, the PKCS #9 attribute
// holding a shared secret a CA may use to authorise revocation later.
//
// It travels in the clear inside the request, so it is a
// weak authenticator and RFC 2985 says as much.  It is read because
// requests carry it, not because it should be relied on.
pub fn oid_challenge_password() -> AsnOid []
    asn1oid.oid([1, 2, 840, 113549, 1, 9, 7])

// One attribute of a certification request.
//
// A plain struct rather than a `@value` one because it appears inside
// a `Result` and inside an option, and a `@value` struct may be
// neither (E2015).
pub struct X509CsrAttribute
    // Which attribute it is.
    oid: AsnOid
    // Its values, each as its own DER, whole.  A SET in the encoding,
    // usually of exactly one, and the values are handed over unparsed
    // because their structure is the attribute type's business.
    values: [Bytes]

// A PKCS #10 certification request, read.
pub struct X509Csr
    // 0 for the one version RFC 2986 defines.
    version: Int
    // The distinguished name the requester is asking to be certified
    // under.  A CA may certify a different one; this is what was
    // asked.
    subject: AsnName
    // The public key to be certified.  The signature on this request
    // is by the matching private key, so verifying it proves the
    // requester holds it.
    public_key: AsnSubjectPublicKeyInfo
    // The attributes, in the order they were written.
    attributes: [X509CsrAttribute]
    // The algorithm the request was signed with.
    signature_algorithm: AsnAlgorithmId
    // The signature over the CertificationRequestInfo.
    signature: AsnBitString
    // The span of the CertificationRequestInfo, exactly as it arrived.
    // The bytes the signature covers.
    info: AsnSpan

// ── the parts the readers below share ──────────────────────────────

// An asn1-nv refusal as this package's own.
//
// The cause is carried whole rather than flattened to a string, so a
// caller that wants to know it was a non-minimal length rather than a
// truncation can match on `decode_cause`.
fn not_der<T>(r: Result<T, AsnDecodeError>) -> Result<T, X509Error> []
    match r
        Ok(v)  => Ok(v)
        Err(e) => Err(X509NotDer(cause: e))

// The children of the SEQUENCE at `off`, refusing one with fewer than
// the named fields.
fn fields(src: Bytes, off: Int, limits: AsnLimits, names: [Str]) -> Result<[AsnSpan], X509Error> []
    let kids = not_der(asn1univ.sequence_at(src, off, limits))!
    if list.len(kids) < list.len(names)
        return Err(X509MissingField(at: off, field: names[list.len(kids)]))
    Ok(kids)

// Whether `v` is exactly one DER value, with nothing after it.
//
// An attribute's values and an extension's value are detached copies,
// so nothing else checks that each ends where the structure the OID
// names ends.
fn one_value(v: Bytes, limits: AsnLimits) -> Bool []
    match asn1read.read_document(v, limits)
        Ok(_)  => true
        Err(_) => false

// The Extensions SEQUENCE at `off`, in the order it was written.
fn read_extensions(src: Bytes, off: Int, limits: AsnLimits) -> Result<[AsnExtension], X509Error> []
    var out: [AsnExtension] = []
    for e in not_der(asn1univ.sequence_at(src, off, limits))!
        let parts = fields(src, e.off, limits, ["extnID", "extnValue"])!
        // `critical BOOLEAN DEFAULT FALSE` sits between the two when it
        // is written.
        let critical = if list.len(parts) > 2
            not_der(asn1univ.boolean_at(src, parts[1].off, limits))!
        else
            false
        list.push(out, AsnExtension {
            oid: not_der(asn1univ.oid_at(src, parts[0].off, limits))!,
            critical: critical,
            value: not_der(asn1univ.octet_string_at(src,
                            parts[list.len(parts) - 1].off, limits))! })
    Ok(out)

// The `[0] IMPLICIT Attributes` at `off`.
//
// RFC 2986 writes the SET OF with its own tag REPLACED by `[0]`, so
// `asn1univ.set_of_at` cannot be used and DER's ordering rule — which
// that reader applies — is this module's to check.  The rule is the
// same one: ascending order of the encodings.
fn read_attributes(src: Bytes, off: Int,
                   limits: AsnLimits) -> Result<[X509CsrAttribute], X509Error> []
    let t = not_der(asn1read.peek_tag_at(src, off, limits))!
    if t.class != AsnContext or t.number != 0
        return Err(X509MissingField(at: off, field: "attributes"))
    let kids = not_der(asn1read.children_at(src, off, limits))!
    for i in 1..list.len(kids)
        let before = bytes.to_hex(asn1read.span_bytes(src, kids[i - 1]))
        let here = bytes.to_hex(asn1read.span_bytes(src, kids[i]))
        if here < before
            return Err(X509ImpossibleField(at: kids[i].off, field: "attributes",
                                           why: "DER orders a SET OF by its encodings"))
    var out: [X509CsrAttribute] = []
    for a in kids
        let pair = fields(src, a.off, limits, ["type", "values"])!
        var values: [Bytes] = []
        for v in not_der(asn1univ.set_of_at(src, pair[1].off, limits))!
            list.push(values, asn1read.span_bytes(src, v))
        list.push(out, X509CsrAttribute {
            oid: not_der(asn1univ.oid_at(src, pair[0].off, limits))!,
            values: values })
    Ok(out)

// The whole request at `off`, in the bytes the caller supplied.
fn csr_at(src: Bytes, off: Int, limits: AsnLimits) -> Result<X509Csr, X509Error> []
    let outer = fields(src, off, limits,
                       ["certificationRequestInfo", "signatureAlgorithm", "signature"])!
    let info = outer[0]
    let parts = fields(src, info.off, limits,
                       ["version", "subject", "subjectPKInfo", "attributes"])!
    let version = not_der(asn1univ.integer_at(src, parts[0].off, limits))!
    if version != X509_CSR_VERSION_1
        return Err(X509BadVersion(at: parts[0].off, version: version))
    Ok(X509Csr { version: version,
                 subject: not_der(asn1pkix.name_at(src, parts[1].off, limits))!,
                 public_key: not_der(asn1pkix.spki_at(src, parts[2].off, limits))!,
                 attributes: read_attributes(src, parts[3].off, limits)!,
                 signature_algorithm: not_der(asn1pkix.algorithm_at(src, outer[1].off,
                                                                    limits))!,
                 signature: not_der(asn1univ.bit_string_at(src, outer[2].off, limits))!,
                 info: info })

// The certification request one DER document holds.
//
// Trailing bytes are refused.  The spans in the answer point into
// `src`, which the caller must keep.
//
// ```novo
// use std.bytes
// use asn1read
// use x509csr
//
// fn main() [io]
//     let der = bytes.zeros(0)
//     match x509csr.parse(der, asn1read.default_limits())
//         Ok(r)  => println("${r.version}")
//         Err(e) => println(e.message())
// ```
pub fn parse(src: Bytes, limits: AsnLimits) -> Result<X509Csr, X509Error> []
    not_der(asn1read.read_document(src, limits))!
    csr_at(src, 0, limits)

// The bytes of the CertificationRequestInfo, exactly as they arrived.
//
// What the request's signature is computed over, and the one call here
// that copies a large run of bytes.
pub fn info_bytes(src: Bytes, r: X509Csr) -> Bytes []
    asn1read.span_bytes(src, r.info)

// The span of the CertificationRequestInfo, without copying it.
pub fn info_span(r: X509Csr) -> AsnSpan []
    r.info

// The raw signature bytes, out of the BIT STRING they travel in.
pub fn signature_bytes(r: X509Csr) -> Result<Bytes, X509Error> []
    if r.signature.unused_bits != 0
        return Err(X509ImpossibleField(at: 0, field: "signature",
                                       why: "the BIT STRING has unused bits"))
    Ok(bytes.clone(r.signature.data))

// The name the requester asked to be certified under.
pub fn subject_of(r: X509Csr) -> AsnName []
    r.subject

// The public key the requester asked to have certified.
//
// Hand it to `x509verify.verify_csr` to check that the requester holds
// the matching private key.
pub fn public_key_of(r: X509Csr) -> AsnSubjectPublicKeyInfo []
    r.public_key

// Every attribute, in the order they were written.
pub fn attributes_of(r: X509Csr) -> [X509CsrAttribute] []
    r.attributes[:]

// The attribute with this OID, or `None`.
pub fn attribute_by_oid(r: X509Csr, o: AsnOid) -> ?X509CsrAttribute []
    for a in r.attributes
        if asn1oid.equals(a.oid, o)
            return Some(a)
    None

// The extensions the requester ASKED FOR, out of the
// `extensionRequest` attribute.
//
// Empty when the attribute is absent.  The name says `requested`
// because that is what they are: a CA chooses what to issue, and one
// that copied these into a certificate unexamined would certify
// whatever anybody asked for — including a CA certificate.
//
// They are `AsnExtension` values, the same type a certificate's are, so
// `x509ext`'s readers work on them unchanged and a CA can ask what was
// requested in the same words it asks what it issued.
//
// ```novo
// use std.bytes
// use asn1read
// use x509csr
//
// fn main() [io]
//     let der = bytes.zeros(0)
//     match x509csr.parse(der, asn1read.default_limits())
//         Err(e) => println(e.message())
//         Ok(r)  =>
//             match x509csr.requested_extensions(r, asn1read.default_limits())
//                 Ok(xs) => println("${list.len(xs)}")
//                 Err(e) => println(e.message())
// ```
pub fn requested_extensions(r: X509Csr, limits: AsnLimits) -> Result<[AsnExtension], X509Error> []
    match attribute_by_oid(r, oid_extension_request())
        None    => Ok([])
        Some(a) =>
            // RFC 2986 gives the attribute one value, and that value is
            // the DER of an Extensions SEQUENCE.
            if list.len(a.values) == 0
                return Ok([])
            let v = a.values[0]
            if not one_value(v, limits)
                return Err(X509BadExtensionValue(at: 0, oid: "1.2.840.113549.1.9.14"))
            read_extensions(v, 0, limits)

// The DNS names the requester asked for, out of the requested
// `subjectAltName`.
//
// The one question a CA's front end asks of nearly every request, and
// the one an operator reads off a request before approving it.
pub fn requested_dns_names(r: X509Csr, limits: AsnLimits) -> Result<[Str], X509Error> []
    let exts = requested_extensions(r, limits)!
    match x509ext.subject_alt_name(exts, limits)
        Err(e)       => Err(e)
        Ok(None)     => Ok([])
        Ok(Some(ns)) => Ok(x509ext.dns_names(ns))

// The `challengePassword` attribute's value, or `None`.
//
// It travels in the clear inside the request.  Read because requests
// carry it, not because it authenticates anybody.
pub fn challenge_password(r: X509Csr, limits: AsnLimits) -> Result<?Str, X509Error> []
    match attribute_by_oid(r, oid_challenge_password())
        None    => Ok(None)
        Some(a) =>
            if list.len(a.values) == 0
                return Ok(None)
            let v = a.values[0]
            if not one_value(v, limits)
                return Err(X509BadExtensionValue(at: 0, oid: "1.2.840.113549.1.9.7"))
            match asn1univ.any_string_at(v, 0, limits)
                Ok(s)  => Ok(Some(s))
                Err(_) => Err(X509BadExtensionValue(at: 0, oid: "1.2.840.113549.1.9.7"))

// Whether the request is conforming in the ways a reader can check on
// its own, or the first refusal if it is not.
//
// Version 0, a subject that is present, a public key whose algorithm
// identifier is well formed, and no attribute repeated.  `None` when
// it passes.  A CA runs this before it looks at the signature, so that
// a malformed request is refused for being malformed rather than for
// failing a check it was never going to reach.
pub fn check_conformance(src: Bytes, r: X509Csr, limits: AsnLimits) -> ?X509Error []
    if r.info.off < 0 or r.info.off + r.info.len > bytes.len(src)
        return Some(X509MissingField(at: r.info.off, field: "certificationRequestInfo"))
    if r.version != X509_CSR_VERSION_1
        return Some(X509BadVersion(at: r.info.off, version: r.version))
    if x509name.is_empty(r.subject)
        return Some(X509ImpossibleField(at: r.info.off, field: "subject",
                                        why: "a request asks to be certified under a name"))
    if asn1oid.arc_count(r.public_key.algorithm.algorithm) < 2
        return Some(X509ImpossibleField(at: r.info.off, field: "subjectPKInfo",
                                        why: "an algorithm identifier has at least two arcs"))
    if r.public_key.public_key.unused_bits != 0
        return Some(X509ImpossibleField(at: r.info.off, field: "subjectPublicKey",
                                        why: "a PKIX public key has no unused bits"))
    // An attribute type appears at most once.  Two `extensionRequest`
    // attributes would leave a reader to guess which one the requester
    // meant.
    var seen: [AsnOid] = []
    for a in r.attributes
        if list.contains(seen, a.oid)
            return Some(X509ImpossibleField(at: r.info.off, field: "attributes",
                                            why: "an attribute type appears twice"))
        list.push(seen, a.oid)
    // And every attribute this package reads is the structure its OID
    // names.
    match requested_extensions(r, limits)
        Err(e) => Some(e)
        Ok(_)  => None
